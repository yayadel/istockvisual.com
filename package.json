{
	"name": "istockvisual",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --port 4325 --host",
		"preview:online": "astro build && wrangler dev --remote --port 4325 --ip 0.0.0.0",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"generate-types": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply istockvisual-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply istockvisual-db --remote",
		"keywords:import": "node scripts/import-keywords.mjs",
		"keywords:import:remote": "node scripts/import-keywords.mjs --remote",
		"generate:asset": "node scripts/generate-asset.mjs",
		"agent:prepare": "node scripts/agent-prepare.mjs",
		"agent:release": "node scripts/agent-release.mjs",
		"agent:meta": "node scripts/agent-meta.mjs",
		"agent:meta:py": "python scripts/gemini_meta.py",
		"agent:meta:gemma": "node scripts/agent-meta.mjs --provider=together",
		"agent:meta:gemma:py": "python scripts/gemma_meta.py",
		"agent:import": "node scripts/agent-import.mjs",
		"backlinks:list": "node scripts/agent-backlinks.mjs list",
		"backlinks:kit": "node scripts/agent-backlinks.mjs kit",
		"backlinks:preview": "node scripts/agent-backlinks.mjs run --dry-run",
		"backlinks:run": "node scripts/agent-backlinks.mjs run",
		"backlinks:done": "node scripts/agent-backlinks.mjs done",
		"images:variants": "node scripts/backfill-size-variants.mjs",
		"images:master": "node scripts/backfill-size-variants.mjs",
		"images:previews": "node scripts/backfill-previews.mjs",
		"sync:host-prompt": "node scripts/sync-host-prompt.mjs",
		"sanity:dev": "npm run dev --prefix sanity",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.1",
		"@astrojs/react": "^6.0.2",
		"@imgly/background-removal": "^1.7.0",
		"@sanity/client": "^7.26.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"astro": "^7.2.1",
		"better-auth": "^1.6.27",
		"fast-png": "^8.0.0",
		"groq": "^6.9.2",
		"heic2any": "^0.0.4",
		"imagetracerjs": "^1.2.6",
		"jpeg-js": "^0.4.4",
		"jszip": "^3.10.1",
		"konva": "^9.3.18",
		"onnxruntime-web": "^1.21.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-filerobot-image-editor": "^5.0.0-beta.159",
		"react-konva": "^19.2.5",
		"sharp": "^0.35.3",
		"styled-components": "^6.5.3",
		"wrangler": "^4.121.0"
	}
}
