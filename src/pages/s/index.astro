---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetGrid from '../../components/AssetGrid.astro';
import VisualSearchQuery from '../../components/VisualSearchQuery';
import { CATEGORIES, isCategorySlug } from '../../config/categories';
import { env } from 'cloudflare:workers';
import {
	filterAssetsBySearch,
	listAllAssets,
	parseVisualSearchColors,
	rankAssetsByPalette,
} from '../../lib/generate-asset';
import { searchPath } from '../../lib/paths';
import { purgeVisualSearchUploads } from '../../lib/visual-search-storage';

const q = (Astro.url.searchParams.get('q') || '').trim();
if (q) {
	return Astro.redirect(searchPath(q, Astro.url.searchParams.get('category') || 'all'), 301);
}

const categoryParam = Astro.url.searchParams.get('category') || 'all';
const mode = Astro.url.searchParams.get('mode') || '';
const uploadName = Astro.url.searchParams.get('name') || 'uploaded image';
const queryColors = parseVisualSearchColors(Astro.url.searchParams.get('c'));
const isVisual = mode === 'visual';

const categoryLabel = isCategorySlug(categoryParam)
	? CATEGORIES.find((c) => c.slug === categoryParam)?.label
	: 'All media';

const pool = await listAllAssets(env.DB, Astro.url.origin, 400);
if (isVisual) {
	await purgeVisualSearchUploads(env.MEDIA, false);
}
const scoped = filterAssetsBySearch(
	pool,
	'',
	isCategorySlug(categoryParam) ? categoryParam : 'all',
);
const assets = isVisual ? rankAssetsByPalette(scoped, queryColors) : scoped;
---

<BaseLayout title={isVisual ? 'Visual search' : 'Search'} description="Search photos, illustrations, vectors, and 3D assets.">
	<div class="section-head">
		<div>
			<p class="asset-card__meta">Search</p>
			<h1>{isVisual ? 'Visual search' : 'Search'}</h1>
			<p>
				{
					isVisual
						? `Closest palette matches for “${uploadName}”. Matching uses colors read in your browser.`
						: `Browse ${categoryLabel?.toLowerCase()} or enter a keyword above.`
				}
			</p>
		</div>
	</div>

	{isVisual && <VisualSearchQuery client:load colors={queryColors} />}

	<AssetGrid
		assets={assets}
		emptyMessage={isVisual ? 'No palette matches yet. Try another photo.' : 'No assets matched your search.'}
	/>
</BaseLayout>
