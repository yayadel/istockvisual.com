---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import VisualSearchQuery from '../../components/VisualSearchQuery';
import { env } from 'cloudflare:workers';
import { applyCatalogFilters, catalogHref, parseCatalogQuery } from '../../lib/catalog';
import {
	listAllAssets,
	parseVisualSearchColors,
	rankAssetsByPalette,
} from '../../lib/generate-asset';
import {
	isVisualSearchObjectKey,
	purgeExpiredVisualSearchUploads,
} from '../../lib/visual-search-storage';
import { searchResultsJsonLd } from '../../lib/seo';

const q = (Astro.url.searchParams.get('q') || '').trim();
if (q) {
	return Astro.redirect(catalogHref(parseCatalogQuery(Astro.url, { q })), 301);
}

const query = parseCatalogQuery(Astro.url);
const mode = Astro.url.searchParams.get('mode') || '';
const queryColors = parseVisualSearchColors(Astro.url.searchParams.get('c'));
const queryKey = Astro.url.searchParams.get('key') || '';
const isVisual = mode === 'visual';
const previewUrl =
	isVisual && isVisualSearchObjectKey(queryKey)
		? `/api/visual-search/preview?key=${encodeURIComponent(queryKey)}`
		: null;

const pool = await listAllAssets(env.DB, Astro.url.origin, 600);
if (isVisual) {
	await purgeExpiredVisualSearchUploads(env.MEDIA);
}
const scoped = applyCatalogFilters(pool, query);
const assets = isVisual ? rankAssetsByPalette(scoped, queryColors) : scoped;
const origin = Astro.url.origin;
const title = isVisual ? 'Visual search' : 'Search';
const description =
	'Browse stock photos, illustrations, vectors, and 3D by category, type, color, and keyword.';
const jsonLd = searchResultsJsonLd({
	origin,
	pagePath: Astro.url.pathname,
	title,
	description,
	query: isVisual ? 'visual search' : undefined,
	assets,
	totalCount: assets.length,
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	{
		isVisual && (
			<div class="catalog-visual">
				<VisualSearchQuery client:load colors={queryColors} previewUrl={previewUrl} />
			</div>
		)
	}
	<CatalogView
		assets={assets}
		facetPool={pool}
		query={query}
		emptyMessage={
			isVisual ? 'No palette matches yet. Try another photo.' : 'No assets matched these filters.'
		}
	/>
</BaseLayout>
