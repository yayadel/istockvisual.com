---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import { env } from 'cloudflare:workers';
import { applyCatalogFilters, parseCatalogQuery } from '../../lib/catalog';
import { listAllAssets } from '../../lib/generate-asset';
import { fromPathSlug } from '../../lib/paths';

const raw = Astro.params.q || '';
const q = fromPathSlug(decodeURIComponent(raw));
const query = parseCatalogQuery(Astro.url, { q });
const pool = await listAllAssets(env.DB, Astro.url.origin, 600);
const assets = applyCatalogFilters(pool, query);
const title = q ? `Search: ${q}` : 'Search';
const description = q
	? `Stock photos and graphics matching “${q}” on iStockVisual.`
	: 'Browse stock photos, illustrations, vectors, and 3D by category, type, color, and keyword.';
---

<BaseLayout title={title} description={description} robots="noindex, nofollow">
	<CatalogView
		assets={assets}
		facetPool={pool}
		query={query}
		emptyMessage="No assets matched these filters."
	/>
</BaseLayout>
