---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import { getCategory, isCategorySlug } from '../../config/categories';
import { applyCatalogFilters, CATALOG_PAGE_SIZE, parseCatalogQuery } from '../../lib/catalog';
import { listAllAssets } from '../../lib/generate-asset';
import { collectionPageJsonLd, libraryPageTitle, siteOrigin } from '../../lib/seo';
import { env } from 'cloudflare:workers';

const { category: categorySlug } = Astro.params;

if (!categorySlug || !isCategorySlug(categorySlug)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const category = getCategory(categorySlug)!;
const query = parseCatalogQuery(Astro.url, { type: category.slug });
const pool = await listAllAssets(env.DB, Astro.url.origin, 600);
const assets = applyCatalogFilters(pool, query);
const origin = siteOrigin(Astro.url.origin);
const title = libraryPageTitle(category.label);
const description = `Royalty-free AI-generated ${category.label.toLowerCase()} for commercial and personal use. All images on this site are AI-generated. Free download on StockVisual.`;
const jsonLd = collectionPageJsonLd({
	origin,
	pagePath: `/${category.slug}`,
	title,
	description,
	assets: assets.slice(0, CATALOG_PAGE_SIZE),
	totalCount: assets.length,
	crumbs: [
		{ name: 'Home', path: '/' },
		{ name: category.label, path: `/${category.slug}` },
	],
});
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={jsonLd}
	robots={assets.length === 0 ? 'noindex, follow' : undefined}
>
	<CatalogView
		assets={assets}
		facetPool={pool}
		query={query}
		emptyMessage={`No ${category.label.toLowerCase()} matched these filters.`}
	/>
</BaseLayout>
