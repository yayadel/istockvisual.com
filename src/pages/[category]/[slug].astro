---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetPreviewPanel from '../../components/AssetPreviewPanel';
import { getCategory, isCategorySlug } from '../../config/categories';
import { resolveAssetBySlug } from '../../lib/generate-asset';
import { env } from 'cloudflare:workers';

const { category: categorySlug, slug } = Astro.params;

if (!categorySlug || !slug || !isCategorySlug(categorySlug)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const category = getCategory(categorySlug)!;
const asset = await resolveAssetBySlug(env.DB, Astro.url.origin, category.slug, slug);

if (!asset) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const user = Astro.locals.user;
const needsLogin = !user;
const needsPro = Boolean(user && asset.isPremium && user.plan !== 'pro');
const canDownload = Boolean(user) && !needsPro;
const isGenerated = asset.source === 'generated';
---

<BaseLayout
	title={asset.title}
	description={asset.shortDescription || asset.description || `${asset.title} on iStockVisual`}
>
	<article class="detail">
		<div class="detail__preview">
			{
				asset.previewUrl ? (
					<AssetPreviewPanel client:load imageUrl={asset.previewUrl} title={asset.title} />
				) : (
					<div class="empty">No preview available</div>
				)
			}
		</div>
		<div class="detail__panel">
			<p class="asset-card__meta">
				<a href={`/${category.slug}`}>{category.label}</a>
				{asset.isPremium && <span class="badge badge--premium">Pro</span>}
				{isGenerated && <span class="badge">Generated</span>}
			</p>
			<h1>{asset.title}</h1>
			<p>{asset.shortDescription || asset.description || 'No description provided.'}</p>

			<ul class="meta-list">
				<li><span>License</span><span>{asset.license || 'Standard'}</span></li>
				<li><span>Type</span><span>{asset.fileType || '—'}</span></li>
				<li>
					<span>Dimensions</span>
					<span>
						{asset.width && asset.height ? `${asset.width} × ${asset.height}` : '—'}
					</span>
				</li>
				{asset.medium && (
					<li><span>Medium</span><span>{asset.medium}</span></li>
				)}
				{asset.keyword && (
					<li><span>Keyword</span><span>{asset.keyword}</span></li>
				)}
				<li><span>Tags</span><span>{asset.tags?.join(', ') || '—'}</span></li>
			</ul>

			{
				isGenerated && (
					<section class="asset-extra">
						{asset.creationDescription && (
							<div class="asset-extra__block">
								<h2>Creation description</h2>
								<p>{asset.creationDescription}</p>
							</div>
						)}
						{asset.usageTips && (
							<div class="asset-extra__block">
								<h2>Usage tips</h2>
								<p>{asset.usageTips}</p>
							</div>
						)}
						{
							asset.colorPalette && asset.colorPalette.length > 0 && (
								<div class="asset-extra__block">
									<h2>Color palette</h2>
									<ul class="palette-list">
										{asset.colorPalette.map((swatch) => (
											<li>
												<span
													class="palette-swatch"
													style={`background:${swatch.hex}`}
													title={swatch.hex}
												/>
												<span>{swatch.name}</span>
												<code>{swatch.hex}</code>
											</li>
										))}
									</ul>
								</div>
							)
						}
						{
							asset.depictedElements && asset.depictedElements.length > 0 && (
								<div class="asset-extra__block">
									<h2>Depicted elements</h2>
									<p>{asset.depictedElements.join(', ')}</p>
								</div>
							)
						}
						{
							asset.relatedQueries && asset.relatedQueries.length > 0 && (
								<div class="asset-extra__block">
									<h2>Related searches</h2>
									<ul class="tag-list">
										{asset.relatedQueries.map((query) => (
											<li>
												<a href={`/search?q=${encodeURIComponent(query)}`}>{query}</a>
											</li>
										))}
									</ul>
								</div>
							)
						}
						{
							asset.imagePrompt && (
								<details class="asset-extra__block">
									<summary>Image generation prompt</summary>
									<p>{asset.imagePrompt}</p>
								</details>
							)
						}
					</section>
				)
			}

			<div class="cta-row">
				{
					needsLogin ? (
						<a class="btn btn--primary" href="/login">Log in to download</a>
					) : needsPro ? (
						<a class="btn btn--primary" href="/account">Upgrade to Pro (soon)</a>
					) : (
						<a class="btn btn--primary" href={`/api/download/${asset._id}`}>
							Download original
						</a>
					)
				}
				<a class="btn btn--ghost" href="/tools/ai-edit">Open in AI Edit</a>
			</div>

			{
				!needsLogin && canDownload && !asset.r2ObjectKey && (
					<p class="hint" style="margin-top:1rem">
						Download API is ready, but this asset has no R2 object key yet.
					</p>
				)
			}
		</div>
	</article>
</BaseLayout>
