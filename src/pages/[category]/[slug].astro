---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetPreviewPanel from '../../components/AssetPreviewPanel';
import ColorPalette from '../../components/ColorPalette';
import PromptBlock from '../../components/PromptBlock';
import BasicInfoPanel from '../../components/BasicInfoPanel';
import DownloadPanel from '../../components/DownloadPanel';
import DetailSectionIcon from '../../components/DetailSectionIcon';
import SimilarMasonry from '../../components/SimilarMasonry.astro';
import { getCategory, isCategorySlug } from '../../config/categories';
import { findSimilarAssets, listAllAssets, resolveAssetBySlug } from '../../lib/generate-asset';
import { resolveContentCategories, contentCategoryPath } from '../../lib/content-categories';
import { searchPath } from '../../lib/paths';
import {
	absoluteUrl,
	assetJsonLd,
	assetSearchDescription,
	assetSearchTitle,
	LICENSE_PATH,
} from '../../lib/seo';
import { env } from 'cloudflare:workers';

const { category: categorySlug, slug } = Astro.params;

if (!categorySlug || !slug || !isCategorySlug(categorySlug)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const category = getCategory(categorySlug)!;
const asset = await resolveAssetBySlug(env.DB, Astro.url.origin, category.slug, slug);

if (!asset) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const contentCategories = resolveContentCategories({
	stored: asset.contentCategories || asset.depictedElements,
	title: asset.title,
	keyword: asset.keyword,
});

const user = Astro.locals.user;
const isGenerated = asset.source === 'generated';
const tags = asset.tags ?? [];
const similar = findSimilarAssets(
	await listAllAssets(env.DB, Astro.url.origin, 400),
	asset,
	18,
);

const origin = Astro.url.origin;
const pagePath = `/${category.slug}/${asset.slug}`;
const pageUrl = absoluteUrl(pagePath, origin);
const seoTitle = assetSearchTitle(asset.title);
const seoDescription = assetSearchDescription({
	title: asset.title,
	shortDescription: asset.shortDescription,
	description: asset.description,
	category: category.slug,
});
const ogImage = asset.previewUrl ? absoluteUrl(asset.previewUrl, origin) : undefined;
const jsonLd = assetJsonLd({
	origin,
	pagePath,
	title: asset.title,
	seoTitle,
	seoDescription,
	imageDescription: asset.creationDescription || asset.description || asset.shortDescription,
	imageUrl: ogImage,
	thumbnailUrl: ogImage,
	width: asset.width,
	height: asset.height,
	fileType: asset.fileType,
	medium: asset.medium,
	tags,
	publishedAt: asset.publishedAt,
	categorySlug: category.slug,
	categoryLabel: category.label,
	contentCategories,
});
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	exactTitle
	canonicalUrl={pageUrl}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={asset.title}
	ogImageWidth={asset.width}
	ogImageHeight={asset.height}
	jsonLd={jsonLd}
>
	<article class="detail">
		<div class="detail__shell">
			<header class="detail__title">
				<nav class="detail__breadcrumb" aria-label="Breadcrumb">
					<ol>
						<li>
							<a href={`/${category.slug}`}>{category.label}</a>
						</li>
						{
							contentCategories.map((label) => (
								<li>
									<a href={contentCategoryPath(label)}>{label}</a>
								</li>
							))
						}
					</ol>
				</nav>
				<div class="detail__title-row">
					<h1>{seoTitle}</h1>
				</div>
				{asset.shortDescription && (
					<p class="detail__lead">{asset.shortDescription}</p>
				)}
			</header>

			<div class="detail__stage">
				<div class="detail__preview">
					{
						asset.previewUrl ? (
							<AssetPreviewPanel
								client:load
								imageUrl={asset.previewUrl}
								title={asset.title}
								width={asset.width}
								height={asset.height}
								shareUrl={new URL(`/${category.slug}/${asset.slug}`, Astro.url.origin).href}
								loggedIn={Boolean(user)}
								isPro={user?.plan === 'pro'}
								assetId={asset._id}
							/>
						) : (
							<div class="empty">No preview available</div>
						)
					}
				</div>

				<aside class="detail__info">
					<DownloadPanel
						client:only="react"
						assetId={asset._id}
						title={asset.title}
						slug={asset.slug}
						previewUrl={asset.previewUrl}
						sourceWidth={asset.width || 1536}
						sourceHeight={asset.height || 1024}
						loggedIn={Boolean(user)}
						isPro={user?.plan === 'pro'}
						loginHref={`/login?next=${encodeURIComponent(`/${category.slug}/${asset.slug}`)}`}
						signupHref={`/signup?next=${encodeURIComponent(`/${category.slug}/${asset.slug}`)}`}
						pageUrl={new URL(`/${category.slug}/${asset.slug}`, Astro.url.origin).href}
					>
						<div class="download-panel">
							<p class="download-panel__hint">Loading sizes…</p>
						</div>
					</DownloadPanel>
					<BasicInfoPanel
						license={asset.license || 'Free to use — commercial OK, attribution required'}
						licenseHref={LICENSE_PATH}
						categories={contentCategories.map((label) => ({
							label,
							href: contentCategoryPath(label),
						}))}
					/>
					{
						user?.plan !== 'pro' && (
							<a
								class="pro-promo"
								href="/price"
							>
								<span class="pro-promo__glow" aria-hidden="true" />
								<span class="pro-promo__badge">Pro</span>
								<span class="pro-promo__copy">
									<strong>Unlimited HD downloads</strong>
									<span>Unlock 2K, 4K, and 8K for every image — no monthly caps.</span>
								</span>
								<span class="pro-promo__cta">Go Pro</span>
							</a>
						)
					}
				</aside>
			</div>

			{
				isGenerated && (
					<section class="detail__story">
						{
							(asset.creationDescription || asset.usageTips) && (
								<div class="story-pair">
									{asset.creationDescription && (
										<article class="story-block">
											<h2>
												<DetailSectionIcon name="spark" />
												<span>Creation description</span>
											</h2>
											<p>{asset.creationDescription}</p>
										</article>
									)}
									{asset.usageTips && (
										<article class="story-block">
											<h2>
												<DetailSectionIcon name="tip" />
												<span>Usage tips</span>
											</h2>
											<p>{asset.usageTips}</p>
										</article>
									)}
								</div>
							)
						}
						{
							asset.colorPalette && asset.colorPalette.length > 0 && (
								<article class="story-block story-block--palette">
									<h2>
										<DetailSectionIcon name="palette" />
										<span>Color palette</span>
									</h2>
									<ColorPalette client:load swatches={asset.colorPalette} />
								</article>
							)
						}
						{
							asset.imagePrompt && (
								<article class="story-block story-block--prompt">
									<h2>
										<DetailSectionIcon name="prompt" />
										<span>Image generation prompt</span>
									</h2>
									<PromptBlock client:load prompt={asset.imagePrompt} />
								</article>
							)
						}
					</section>
				)
			}

			{
				tags.length > 0 && (
					<section class="detail__discover">
						<div class="chip-block">
							<header class="chip-block__head">
								<h2>
									<DetailSectionIcon name="tag" />
									<span>Tags</span>
								</h2>
								<p class="chip-block__count">
									<strong>{tags.length}</strong>
									{tags.length === 1 ? ' keyword' : ' keywords'}
								</p>
							</header>
							<div class="chip-block__rule" aria-hidden="true"></div>
							<ul class="chip-cloud">
								{tags.map((tag) => (
									<li>
										<a href={searchPath(tag)}>
											<span class="chip-cloud__hash" aria-hidden="true">#</span>
											<span>{tag}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					</section>
				)
			}
		</div>

		<SimilarMasonry
			assets={similar}
			viewAllHref={`/${category.slug}`}
			viewAllLabel={`View all ${category.label.toLowerCase()}`}
		/>
	</article>
</BaseLayout>
