---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { IMAGE_SOURCE_NOTICE, LICENSE_PATH, SITE_BRAND } from '../../lib/seo';

const htmlCredit = `<a href="https://stockvisual.org/">StockVisual</a>`;
const htmlDeep = `Scene title — <a href="https://stockvisual.org/c/">source</a>`;
const badgeHtml = `<a href="https://stockvisual.org/"><img src="https://stockvisual.org/badge.svg" alt="StockVisual" width="168" height="32"></a>`;
---

<LegalLayout
	title="Press & Embed"
	description={`Press facts, brand name, and optional embed snippets for StockVisual. CC0 AI-generated library — attribution is not required. ${IMAGE_SOURCE_NOTICE}`}
	heading="Press & Embed"
	lede={`Facts and copy-ready links for directories, articles, and optional credit. ${IMAGE_SOURCE_NOTICE} Attribution is not required under CC0.`}
	kicker="Press"
>
	<h2>One line</h2>
	<p>
		{SITE_BRAND} is a CC0 library of photos, illustrations, vectors, and 3D stills, plus in-browser
		crop, convert, vectorize, and palette tools. {IMAGE_SOURCE_NOTICE}
	</p>

	<h2>Facts</h2>
	<ul>
		<li>Website: <a href="/">https://stockvisual.org</a></li>
		<li>Collections: <a href="/c/">https://stockvisual.org/c/</a></li>
		<li>License: <a href={LICENSE_PATH}>CC0 1.0</a> — commercial and personal use, no attribution required</li>
		<li>Image source: {IMAGE_SOURCE_NOTICE}</li>
		<li>Free downloads: 512 and 1K. 2K / 4K / 8K on Pro</li>
		<li>Optional credit: <strong>Generated by {SITE_BRAND}</strong></li>
	</ul>

	<h2>Brand anchors</h2>
	<p>
		If you link to the library, prefer the brand name, a plain URL, or a generic word such as
		“source” or “website”. Deep-link collections when the article is about a topic, not only the
		homepage.
	</p>
	<ul>
		<li><a href="/">StockVisual</a></li>
		<li><a href="/c/">source</a> (all collections)</li>
		<li><a href="/c/textures">this collection</a> (textures)</li>
		<li><a href="/c/3d-assets">this collection</a> (3D assets)</li>
		<li><a href="/tools/image">website</a> (image editor)</li>
	</ul>

	<h2>Optional HTML credit</h2>
	<p>Copy from the asset page, or use one of these:</p>
	<pre><code>{htmlCredit}</code></pre>
	<pre><code>{htmlDeep}</code></pre>
	<pre><code>{badgeHtml}</code></pre>
	<p>
		<a href="/"><img src="/badge.svg" alt="StockVisual" width="168" height="32" /></a>
	</p>
</LegalLayout>
