---
import LegalLayout from '../../layouts/LegalLayout.astro';
import SupportChat from '../../components/SupportChat';
import { LEGAL_CONTACT_EMAIL } from '../../lib/seo';
---

<LegalLayout
	title="Help"
	description="iStockVisual assistant for questions about licenses, downloads, plans, refunds, and studio tools."
	heading="Help"
	lede="Ask the site assistant about the library, Pro sizes, attribution, refunds, and in-browser tools. No account required."
>
	<p>
		This chat answers from iStockVisual’s internal support brief (license, plans, refunds, tools,
		and privacy). For a refund or an account issue, email{' '}
		<a href={`mailto:${LEGAL_CONTACT_EMAIL}`}>{LEGAL_CONTACT_EMAIL}</a>.
	</p>
	<div class="support-chat-embed">
		<SupportChat client:load variant="page" />
	</div>
</LegalLayout>
