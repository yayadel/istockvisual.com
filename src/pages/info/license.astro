---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="License"
	description="iStockVisual license terms: free for commercial and personal use, attribution required."
>
	<section class="license-page">
		<div class="section-head">
			<div>
				<p class="asset-card__meta">Legal</p>
				<h1>License</h1>
				<p>Free for commercial and personal use. Attribution is required.</p>
			</div>
		</div>

		<article class="license-copy">
			<h2>What you can do</h2>
			<p>
				Images on iStockVisual may be downloaded and used in commercial and personal projects,
				including websites, ads, social posts, presentations, and print.
			</p>
			<ul>
				<li>Use in digital and print media</li>
				<li>Use in commercial marketing and products</li>
				<li>Edit, crop, and combine with other artwork</li>
			</ul>

			<h2>Attribution</h2>
			<p>
				Credit the source when you use an image, for example:
				<strong> Generated by iStockVisual.com</strong>
			</p>

			<h2>What you cannot do</h2>
			<ul>
				<li>Resell or redistribute the original file as a standalone stock asset</li>
				<li>Claim exclusive ownership of the unmodified image</li>
				<li>Use the image to imply endorsement by iStockVisual</li>
			</ul>

			<h2>High-resolution downloads</h2>
			<p>
				500 and 1K previews are free. 2K, 4K, and 8K files require a Pro membership. License terms
				above apply to every size.
			</p>
		</article>
	</section>
</BaseLayout>

<style>
	.license-page {
		width: min(100% - 2rem, 760px);
		margin-inline: auto;
	}

	.license-copy {
		display: grid;
		gap: 0.85rem;
		color: var(--text-muted);
		line-height: 1.65;
	}

	.license-copy h2 {
		margin: 0.8rem 0 0;
		font-size: 1.05rem;
		color: var(--text);
	}

	.license-copy p,
	.license-copy ul {
		margin: 0;
	}

	.license-copy ul {
		padding-left: 1.15rem;
	}
</style>
