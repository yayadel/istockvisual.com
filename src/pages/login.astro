---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/AuthForm';

if (Astro.locals.user) {
	const next = Astro.url.searchParams.get('next');
	return Astro.redirect(next && next.startsWith('/') ? next : '/account');
}

const next = Astro.url.searchParams.get('next') ?? '';
---

<BaseLayout title="Log in">
	<div class="auth-panel">
		<h1>Log in</h1>
		<p class="hint">Access downloads and your membership plan.</p>
		<AuthForm client:load mode="login" redirectTo={next} />
	</div>
</BaseLayout>
