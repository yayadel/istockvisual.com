---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolsMasthead from '../../components/ToolsMasthead.astro';
import ImageConverterApp from '../../components/ImageConverterApp';
---

<BaseLayout
	title="Image Convert — Free Local Format Converter"
	description="Convert JPG, PNG, WebP, HEIC and more entirely in your browser. Free, private, no uploads."
>
	<div class="tools-page">
		<ToolsMasthead
			active="convert"
			title="Image Convert"
			lede="Batch convert formats, resize, and compress without leaving this tab."
			privacy="Free to use. Conversion stays local. Files are never uploaded to our servers."
		/>

		<ImageConverterApp client:only="react">
			<div class="tools-page__boot" aria-hidden="true">
				<div class="tools-rail">
					<p class="tools-rail__copy">Loading converter…</p>
				</div>
			</div>
		</ImageConverterApp>
	</div>
</BaseLayout>
