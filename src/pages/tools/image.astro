---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolsMasthead from '../../components/ToolsMasthead.astro';
import ImageToolWorkspace from '../../components/ImageToolWorkspace';

const user = Astro.locals.user;
---

<BaseLayout
	title="Image Tool — Free Browser Photo Editor"
	description="Free on-device image editor: adjust, crop, remove background, and expand. No uploads stored. No personal data kept."
>
	<div class="tools-page">
		<ToolsMasthead
			active="image"
			title="Image Tool"
			lede="Adjust, crop, remove background, and expand — right in the browser."
			privacy="Free to use. Runs on your device. We don’t store uploads or personal data."
		/>
		<ImageToolWorkspace
			client:load
			loggedIn={Boolean(user)}
			isPro={user?.plan === 'pro'}
		/>
	</div>
</BaseLayout>
