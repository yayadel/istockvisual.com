---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageToolWorkspace from '../../components/ImageToolWorkspace';

const user = Astro.locals.user;
---

<BaseLayout
	title="Image Tool — Free Browser Photo Editor"
	description="Free on-device image editor: adjust, crop, remove background, and expand. No uploads stored. No personal data kept."
>
	<section class="image-tool-hero" aria-labelledby="image-tool-title">
		<div class="image-tool-hero__media" aria-hidden="true">
			<img src="/demo/studio-orb.jpg" alt="" />
		</div>
		<div class="image-tool-hero__veil" aria-hidden="true"></div>
		<div class="image-tool-hero__content">
			<p class="image-tool-hero__eyebrow">iStockVisual · Tool</p>
			<h1 id="image-tool-title">Image Tool</h1>
			<p class="image-tool-hero__lede">
				Edit any photo in your browser — adjust, crop, remove background, expand.
			</p>
			<ul class="image-tool-hero__trust">
				<li>
					<strong>Free</strong>
					<span>Every size, every tool</span>
				</li>
				<li>
					<strong>Private</strong>
					<span>No personal data kept</span>
				</li>
				<li>
					<strong>Local</strong>
					<span>Images never leave your device</span>
				</li>
			</ul>
		</div>
	</section>

	<ImageToolWorkspace
		client:load
		loggedIn={Boolean(user)}
		isPro={user?.plan === 'pro'}
	/>
</BaseLayout>
