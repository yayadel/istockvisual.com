---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import {
	getContentCategoryBySlug,
	isContentCategorySlug,
} from '../../lib/content-categories';
import { applyCatalogFilters, CATALOG_PAGE_SIZE, parseCatalogQuery } from '../../lib/catalog';
import { listAllAssets } from '../../lib/generate-asset';
import { collectionPageJsonLd, libraryPageTitle, siteOrigin } from '../../lib/seo';
import { env } from 'cloudflare:workers';

const slug = Astro.params.slug || '';

if (!slug || !isContentCategorySlug(slug)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const topic = getContentCategoryBySlug(slug)!;
const query = parseCatalogQuery(Astro.url, { topic: topic.slug });
const pool = await listAllAssets(env.DB, Astro.url.origin, 600);
const assets = applyCatalogFilters(pool, query);
const origin = siteOrigin(Astro.url.origin);
const title = libraryPageTitle(topic.label);
const description = `Royalty-free AI-generated ${topic.label} stock images for commercial and personal use. All images on this site are AI-generated. Free download on StockVisual.`;
const jsonLd = collectionPageJsonLd({
	origin,
	pagePath: `/c/${topic.slug}`,
	title,
	description,
	assets: assets.slice(0, CATALOG_PAGE_SIZE),
	totalCount: assets.length,
	crumbs: [
		{ name: 'Home', path: '/' },
		{ name: 'Categories', path: '/c/' },
		{ name: topic.label, path: `/c/${topic.slug}` },
	],
});
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={jsonLd}
	robots={assets.length === 0 ? 'noindex, follow' : undefined}
>
	<CatalogView
		assets={assets}
		facetPool={pool}
		query={query}
		emptyMessage={`No ${topic.label.toLowerCase()} assets matched these filters.`}
	/>
</BaseLayout>
