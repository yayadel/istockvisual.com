---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetGrid from '../components/AssetGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import HomeMarkIcon from '../components/HomeMarkIcon.astro';
import { CATEGORIES } from '../config/categories';
import { listFeaturedAssets, listTopSearchKeywords } from '../lib/generate-asset';
import { formatAssetTitle } from '../lib/asset-types';
import { searchPath } from '../lib/paths';
import { LIFETIME_PLAN } from '../lib/pricing';
import { isSanityConfigured } from '../lib/sanity';
import { env } from 'cloudflare:workers';

const featured = await listFeaturedAssets(env.DB, Astro.url.origin, 8);
const topKeywords = await listTopSearchKeywords(env.DB, 16);
const usingDemo = !isSanityConfigured();

const studioTools = [
	{
		id: 'image' as const,
		index: '01',
		title: 'Image Editor',
		lede: 'Adjust, crop, remove backgrounds, and expand photos in the browser.',
		href: '/tools/image',
		hint: 'Adjust · Crop · Remove BG · Expand',
	},
	{
		id: 'convert' as const,
		index: '02',
		title: 'Image Convert',
		lede: 'Batch convert JPG, PNG, WebP, and HEIC with quality and scale controls.',
		href: '/tools/convert',
		hint: 'Format · Quality · Batch ZIP',
	},
	{
		id: 'vectorize' as const,
		index: '03',
		title: 'Image Vectorizer',
		lede: 'Trace bitmaps into clean SVG paths, then copy the code or download the file.',
		href: '/tools/vectorize',
		hint: 'Bitmap → SVG · Local trace',
	},
	{
		id: 'social' as const,
		index: '04',
		title: 'Social Resizer',
		lede: 'Fit one batch to Instagram, TikTok, YouTube, Facebook, and LinkedIn.',
		href: '/tools/social',
		hint: 'Presets · Focus · ZIP export',
	},
	{
		id: 'watermark' as const,
		index: '05',
		title: 'Batch Watermark',
		lede: 'Stamp text or logo marks that scale with each photo. Tile or nine-point place.',
		href: '/tools/watermark',
		hint: 'Text · Logo · Tile pattern',
	},
	{
		id: 'palette' as const,
		index: '06',
		title: 'Palette Generator',
		lede: 'Extract dominant colors. Copy HEX, RGB, or HSL, or export CSS and Tailwind.',
		href: '/tools/palette',
		hint: 'Swatches · Eyedropper · Export',
	},
];

const proPerks = [
	{ icon: 'res' as const, title: '2K · 4K · 8K', text: 'High-resolution files while your plan is active.' },
	{ icon: 'format' as const, title: 'JPG, PNG, WEBP, SVG', text: 'Export the format your project needs.' },
	{ icon: 'license' as const, title: 'Commercial license', text: 'Ads, sites, and products. Attribution required.' },
	{ icon: 'refund' as const, title: '7-day refund', text: 'Not satisfied? Request a full refund.' },
];
---

<BaseLayout title="iStockVisual" description="Stock photos, illustrations, vectors, and 3D — with AI editing tools.">
	<section class="hero" aria-label="Hero">
		<div class="hero__media" aria-hidden="true"></div>
		<div class="hero__content">
			<h1 class="hero__brand">Visuals ready for your next brief</h1>
			<p class="hero__lead">
				Photos, illustrations, vectors, and 3D packs — curated for campaigns, products, and creative teams.
			</p>
			<SearchBar variant="hero" />
		</div>
	</section>

	<section class="home-pro" aria-labelledby="home-pro-title">
		<span class="home-pro__mark" aria-hidden="true">PRO</span>
		<span class="home-pro__res" aria-hidden="true">4K</span>
		<div class="home-pro__copy">
			<p class="home-kicker">
				<span class="home-kicker__icon"><HomeMarkIcon name="pro" /></span>
				iStockVisual Pro
			</p>
			<h2 id="home-pro-title">Unlock 2K, 4K, and 8K downloads</h2>
			<p>
				Free members keep 500 and 1K previews. Pro unlocks every size and format for commercial work —
				Lifetime Access from {LIFETIME_PLAN.price}, paid once.
			</p>
			<a class="btn home-pro__cta" href="/price">See Pro plans</a>
		</div>
		<ul class="home-pro__perks">
			{
				proPerks.map((perk) => (
					<li>
						<span class="home-pro__perk-icon">
							<HomeMarkIcon name={perk.icon} />
						</span>
						<div>
							<strong>{perk.title}</strong>
							<span>{perk.text}</span>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="home-tools" aria-labelledby="home-tools-title">
		<div class="section-head">
			<div>
				<p class="home-kicker home-kicker--on-light">
					<span class="home-kicker__icon"><HomeMarkIcon name="image" /></span>
					Studio
				</p>
				<h2 id="home-tools-title">Six editing tools, in the browser</h2>
				<p>Files stay on your device. No upload unless you choose visual search.</p>
			</div>
			<a class="btn btn--ghost" href="/tools/image">Open tools</a>
		</div>
		<div class="home-tools__grid">
			{
				studioTools.map((tool) => (
					<a class="home-tools__card" href={tool.href}>
						<span class="home-tools__glyph">
							<HomeMarkIcon name={tool.id} />
						</span>
						<span class="home-tools__index">{tool.index}</span>
						<h3>{tool.title}</h3>
						<p>{tool.lede}</p>
						<span class="home-tools__hint">{tool.hint}</span>
					</a>
				))
			}
		</div>
	</section>

	{
		topKeywords.length > 0 && (
			<section class="home-top-search" aria-labelledby="home-top-search-title">
				<span class="home-top-search__mark" aria-hidden="true">
					<HomeMarkIcon name="search" />
				</span>
				<div class="section-head">
					<div>
						<p class="home-kicker home-kicker--on-light">
							<span class="home-kicker__icon">
								<HomeMarkIcon name="search" />
							</span>
							Discover
						</p>
						<h2 id="home-top-search-title">Top search</h2>
						<p>Popular keywords from the library — open any one to see matching results.</p>
					</div>
				</div>
				<ol class="home-top-search__list">
					{topKeywords.map((keyword) => (
						<li>
							<a href={searchPath(keyword)}>
								<span aria-hidden="true">#</span>
								{formatAssetTitle(keyword)}
							</a>
						</li>
					))}
				</ol>
			</section>
		)
	}

	<section class="home-cats" aria-labelledby="home-cats-title">
		<div class="section-head">
			<div>
				<p class="home-kicker home-kicker--on-light">
					<span class="home-kicker__icon"><HomeMarkIcon name="grid" /></span>
					Library
				</p>
				<h2 id="home-cats-title">Explore categories</h2>
				<p>Photos, illustrations, vectors, and 3D — pick a library and start browsing.</p>
			</div>
		</div>
		<div class="home-cats__grid">
			{
				[
					{ slug: 'photos', label: 'Photos', icon: 'image' as const, lede: 'Campaign stills, products, and documentary frames.' },
					{ slug: 'illustrations', label: 'Illustrations', icon: 'illustrations' as const, lede: 'Drawn scenes, concepts, and editorial art.' },
					{ slug: 'vectors', label: 'Vectors', icon: 'vectorize' as const, lede: 'Clean scalable graphics for print and UI.' },
					{ slug: '3d', label: '3D', icon: 'cube' as const, lede: 'Renders, packs, and dimensional mockups.' },
				].map((category) => (
					<a class="home-cats__card" href={`/${category.slug}`}>
						<span class="home-cats__glyph">
							<HomeMarkIcon name={category.icon} />
						</span>
						<span class="home-cats__mark" aria-hidden="true">
							{category.label.slice(0, 2)}
						</span>
						<h3>{category.label}</h3>
						<p>{category.lede}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="home-featured" aria-labelledby="home-featured-title">
		<div class="section-head">
			<div>
				<p class="home-kicker home-kicker--on-light">
					<span class="home-kicker__icon"><HomeMarkIcon name="spark" /></span>
					Featured
				</p>
				<h2 id="home-featured-title">Featured assets</h2>
				<p>
					{
						usingDemo
							? 'Showing local demo assets until Sanity project IDs are configured.'
							: 'Latest published assets from the library.'
					}
				</p>
			</div>
			<a class="btn btn--ghost" href="/photos">View all</a>
		</div>
		<AssetGrid assets={featured} />
	</section>
</BaseLayout>
