---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetGrid from '../components/AssetGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import HomeMarkIcon from '../components/HomeMarkIcon.astro';
import { assetMatchesContentCategory, contentCategoryPath } from '../lib/content-categories';
import { listFeaturedAssets, listTopSearchKeywords } from '../lib/generate-asset';
import { listTopContentCategoriesByCount } from '../lib/generated-assets';
import { formatAssetTitle } from '../lib/asset-types';
import { searchPath } from '../lib/paths';
import { LIFETIME_PLAN } from '../lib/pricing';
import { env } from 'cloudflare:workers';

const origin = Astro.url.origin;
const pool = await listFeaturedAssets(env.DB, origin, 80);
const featured = pool.slice(0, 16);
const topKeywords = await listTopSearchKeywords(env.DB, 16);
const heroKeywords = topKeywords.slice(0, 10);

const categoryFallback = 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=900&q=80';
const rankedCategories = await listTopContentCategoriesByCount(env.DB, 10);
const topCategories = (
	rankedCategories.some((item) => item.count > 0)
		? rankedCategories.filter((item) => item.count > 0)
		: rankedCategories
).slice(0, 10);

const categoryTiles = topCategories.map((category) => {
	const cover = pool.find((asset) => assetMatchesContentCategory(asset, category.slug));
	return {
		label: category.label,
		href: contentCategoryPath(category.slug),
		image: cover?.previewUrl || categoryFallback,
	};
});

const columnSize = Math.ceil(topKeywords.length / 4) || 1;
const popularColumns = [0, 1, 2, 3]
	.map((index) => topKeywords.slice(index * columnSize, (index + 1) * columnSize))
	.filter((column) => column.length > 0);

const proVisual = featured[0]?.previewUrl || categoryFallback;

const studioTools = [
	{
		id: 'image' as const,
		title: 'Image Editor',
		lede: 'Adjust, crop, remove backgrounds, and expand photos in the browser.',
		href: '/tools/image',
	},
	{
		id: 'convert' as const,
		title: 'Image Convert',
		lede: 'Batch convert JPG, PNG, WebP, and HEIC with quality and scale controls.',
		href: '/tools/convert',
	},
	{
		id: 'vectorize' as const,
		title: 'Image Vectorizer',
		lede: 'Trace bitmaps into clean SVG paths, then copy the code or download the file.',
		href: '/tools/vectorize',
	},
	{
		id: 'social' as const,
		title: 'Social Resizer',
		lede: 'Fit one batch to Instagram, TikTok, YouTube, Facebook, and LinkedIn.',
		href: '/tools/social',
	},
	{
		id: 'watermark' as const,
		title: 'Batch Watermark',
		lede: 'Stamp text or logo marks that scale with each photo. Tile or nine-point place.',
		href: '/tools/watermark',
	},
	{
		id: 'palette' as const,
		title: 'Palette Generator',
		lede: 'Extract dominant colors. Copy HEX, RGB, or HSL, or export CSS and Tailwind.',
		href: '/tools/palette',
	},
];

const proPerks = [
	{ icon: 'res' as const, title: '2K · 4K · 8K' },
	{ icon: 'format' as const, title: 'JPG, PNG, WEBP, SVG' },
	{ icon: 'license' as const, title: 'Commercial license' },
	{ icon: 'refund' as const, title: '7-day refund' },
];
---

<BaseLayout title="iStockVisual" description="Stock photos, illustrations, vectors, and 3D — with AI editing tools.">
	<section class="hero" aria-label="Hero">
		<div class="hero__media" aria-hidden="true"></div>
		<div class="hero__content">
			<h1 class="hero__brand">Huge Collections of Stock Photos, Illustrations &amp; 3D</h1>
			<p class="hero__lead">
				High-quality stock images shared for campaigns, products, and creative teams.
			</p>
			<SearchBar variant="hero" placeholder="Search images, vectors and 3D" />
			{
				heroKeywords.length > 0 && (
					<p class="hero__popular">
						Popular Images:{' '}
						{heroKeywords.map((keyword, index) => (
							<>
								<a href={searchPath(keyword)}>{formatAssetTitle(keyword)}</a>
								{index < heroKeywords.length - 1 ? ', ' : '.'}
							</>
						))}
					</p>
				)
			}
		</div>
	</section>

	<section class="home-cats" aria-label="Popular categories">
		<button class="home-cats__nav home-cats__nav--prev" type="button" aria-label="Previous categories" data-cats-prev>
			‹
		</button>
		<div class="home-cats__scroller" data-cats-scroller>
			{
				categoryTiles.map((category) => (
					<a class="home-cats__card" href={category.href}>
						<img src={category.image} alt="" />
						<span class="home-cats__label">{category.label}</span>
					</a>
				))
			}
		</div>
		<button class="home-cats__nav home-cats__nav--next" type="button" aria-label="Next categories" data-cats-next>
			›
		</button>
	</section>

	<section class="home-featured" aria-labelledby="home-featured-title">
		<div class="section-head">
			<div>
				<h2 id="home-featured-title">Free stock photos</h2>
				<p>Latest published assets from the library.</p>
			</div>
			<a class="btn btn--ghost" href="/photos">View all</a>
		</div>
		<AssetGrid assets={featured} />
	</section>

	<section class="home-bleed home-pro" aria-labelledby="home-pro-title">
		<div class="home-bleed__inner home-pro__layout">
			<div class="home-pro__media">
				<img src={proVisual} alt="" />
			</div>
			<div class="home-pro__copy">
				<p class="home-kicker">
					<span class="home-kicker__icon"><HomeMarkIcon name="pro" /></span>
					iStockVisual Pro
				</p>
				<h2 id="home-pro-title">Unlock 2K, 4K, and 8K downloads</h2>
				<p>
					Free members keep 500 and 1K previews. Pro unlocks every size and format for commercial work —
					Lifetime Access from {LIFETIME_PLAN.price}, paid once.
				</p>
				<ul class="home-pro__perks">
					{
						proPerks.map((perk) => (
							<li>
								<span class="home-pro__perk-icon">
									<HomeMarkIcon name={perk.icon} />
								</span>
								<strong>{perk.title}</strong>
							</li>
						))
					}
				</ul>
				<a class="btn home-pro__cta" href="/price">See Pro plans</a>
			</div>
		</div>
	</section>

	<section class="home-tools" aria-labelledby="home-tools-title">
		<div class="section-head">
			<div>
				<h2 id="home-tools-title">Six editing tools, in the browser</h2>
				<p>Files stay on your device. No upload unless you choose visual search.</p>
			</div>
			<a class="btn btn--ghost" href="/tools/image">Open tools</a>
		</div>
		<div class="home-tools__grid">
			{
				studioTools.map((tool) => (
					<a class="home-tools__card" href={tool.href}>
						<span class="home-tools__glyph">
							<HomeMarkIcon name={tool.id} />
						</span>
						<h3>{tool.title}</h3>
						<p>{tool.lede}</p>
					</a>
				))
			}
		</div>
	</section>

	{
		popularColumns.length > 0 && (
			<section class="home-bleed home-top-search" aria-labelledby="home-top-search-title">
				<div class="home-bleed__inner">
					<h2 id="home-top-search-title">Popular searches</h2>
					<div class="home-top-search__cols">
						{popularColumns.map((column) => (
							<ul>
								{column.map((keyword) => (
									<li>
										<a href={searchPath(keyword)}>{formatAssetTitle(keyword)}</a>
									</li>
								))}
							</ul>
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>
