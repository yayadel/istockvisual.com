---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetGrid from '../components/AssetGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import HomeMarkIcon from '../components/HomeMarkIcon.astro';
import HomeCatsMarquee from '../components/HomeCatsMarquee.astro';
import { assetMatchesContentCategory, contentCategoryPath, CONTENT_CATEGORY_PAGES } from '../lib/content-categories';
import { listFeaturedAssets, listTopSearchKeywords } from '../lib/generate-asset';
import { listTopContentCategoriesByCount } from '../lib/generated-assets';
import { formatAssetTitle } from '../lib/asset-types';
import { searchPath } from '../lib/paths';
import { LIFETIME_PLAN } from '../lib/pricing';
import { env } from 'cloudflare:workers';
import { homeJsonLd, LICENSE_PATH, SITE_HOME_DESCRIPTION, SITE_HOME_TITLE, siteOrigin } from '../lib/seo';

const origin = siteOrigin(Astro.url.origin);
const seenTitles = new Set<string>();
const pool = (await listFeaturedAssets(env.DB, origin, 80)).filter((asset) => {
	const key = asset.title.trim().toLowerCase();
	if (!key || seenTitles.has(key)) return false;
	seenTitles.add(key);
	return true;
});
const featured = pool.slice(0, 16);
const topKeywords = await listTopSearchKeywords(env.DB, 16);
const heroKeywords = topKeywords.slice(0, 10);

const categoryFallback = 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=900&q=80';
const rankedCategories = await listTopContentCategoriesByCount(env.DB, CONTENT_CATEGORY_PAGES.length);
const topCategories = rankedCategories.some((item) => item.count > 0)
	? rankedCategories
	: rankedCategories;

const categoryTiles = topCategories.map((category) => {
	const cover = pool.find((asset) => assetMatchesContentCategory(asset, category.slug));
	return {
		label: category.label,
		href: contentCategoryPath(category.slug),
		image: cover?.previewUrl || categoryFallback,
	};
});

const marqueeTiles = categoryTiles;

const columnSize = Math.ceil(topKeywords.length / 4) || 1;
const popularColumns = [0, 1, 2, 3]
	.map((index) => topKeywords.slice(index * columnSize, (index + 1) * columnSize))
	.filter((column) => column.length > 0);

const proVisual = featured[0]?.previewUrl || categoryFallback;

const homeTitle = SITE_HOME_TITLE;
const homeDescription = SITE_HOME_DESCRIPTION;
const jsonLd = homeJsonLd({
	origin,
	title: homeTitle,
	description: homeDescription,
	assets: featured,
	categories: categoryTiles.map((tile) => ({ name: tile.label, path: tile.href })),
});
const homeOg = featured[0]?.previewUrl;

const toolCover = (index: number) =>
	featured[index]?.previewUrl || pool[index]?.previewUrl || categoryFallback;

const studioTools = [
	{
		id: 'image' as const,
		title: 'Image Editor',
		lede: 'Adjust, crop, remove backgrounds, and expand photos in the browser.',
		href: '/tools/image',
		image: toolCover(1),
		chips: ['Crop', 'Background', 'Expand'],
	},
	{
		id: 'convert' as const,
		title: 'Image Convert',
		lede: 'Batch convert JPG, PNG, WebP, and HEIC with quality and scale controls.',
		href: '/tools/convert',
		image: toolCover(2),
		chips: ['JPG', 'PNG', 'WEBP', 'HEIC'],
	},
	{
		id: 'vectorize' as const,
		title: 'Image Vectorizer',
		lede: 'Trace bitmaps into clean SVG paths, then copy the code or download the file.',
		href: '/tools/vectorize',
		image: toolCover(3),
		chips: ['SVG', 'Paths'],
	},
	{
		id: 'social' as const,
		title: 'Social Resizer',
		lede: 'Fit one batch to Instagram, TikTok, YouTube, Facebook, and LinkedIn.',
		href: '/tools/social',
		image: toolCover(4),
		chips: ['Instagram', 'TikTok', 'YouTube'],
	},
	{
		id: 'watermark' as const,
		title: 'Batch Watermark',
		lede: 'Stamp text or logo marks that scale with each photo. Tile or nine-point place.',
		href: '/tools/watermark',
		image: toolCover(5),
		chips: ['Text', 'Logo', 'Tile'],
	},
	{
		id: 'palette' as const,
		title: 'Palette Generator',
		lede: 'Extract dominant colors. Copy HEX, RGB, or HSL, or export CSS and Tailwind.',
		href: '/tools/palette',
		image: toolCover(6),
		chips: ['HEX', 'RGB', 'HSL', 'CSS'],
	},
];

const proPerks = [
	{ icon: 'res' as const, title: '2K · 4K · 8K' },
	{ icon: 'format' as const, title: 'JPG, PNG, WEBP, SVG' },
	{ icon: 'license' as const, title: 'CC0 License' },
	{ icon: 'refund' as const, title: '7-day trial' },
];
---

<BaseLayout
	title={homeTitle}
	description={homeDescription}
	jsonLd={jsonLd}
	ogImage={homeOg}
	ogImageAlt={featured[0]?.title || homeTitle}
	lcpImage="/hero/home.avif"
>
	<section class="hero" aria-label="Hero">
		<div class="hero__media" aria-hidden="true"></div>
		<div class="hero__content">
			<h1 class="hero__brand">Huge Collections of Stock Photos, Illustrations &amp; 3D</h1>
			<p class="hero__lead">
				High-quality stock images shared for campaigns, products, and creative teams.
				Free under a <a href={LICENSE_PATH}>CC0 License</a>.
			</p>
			<SearchBar variant="hero" placeholder="Search images, vectors and 3D" />
			{
				heroKeywords.length > 0 && (
					<p class="hero__popular">
						Popular Images:{' '}
						{heroKeywords.map((keyword, index) => (
							<>
								<a href={searchPath(keyword)}>{formatAssetTitle(keyword)}</a>
								{index < heroKeywords.length - 1 ? ', ' : '.'}
							</>
						))}
					</p>
				)
			}
		</div>
	</section>

	<HomeCatsMarquee tiles={marqueeTiles} label="Popular categories" />

	<section class="home-featured" aria-labelledby="home-featured-title">
		<div class="section-head">
			<div>
				<h2 id="home-featured-title">Free stock photos</h2>
				<p>Latest published assets from the library.</p>
			</div>
			<a class="home-section-cta" href="/photos">
				View all
				<span aria-hidden="true">→</span>
			</a>
		</div>
		<AssetGrid assets={featured} />
	</section>

	<section class="home-bleed home-pro" aria-labelledby="home-pro-title">
		<div class="home-bleed__inner home-pro__layout">
			<div class="home-pro__media">
				<img src={proVisual} alt="" />
			</div>
			<div class="home-pro__copy">
				<p class="home-kicker">
					<span class="home-kicker__icon"><HomeMarkIcon name="pro" /></span>
					iStockVisual Pro
				</p>
				<h2 id="home-pro-title">Unlock 2K, 4K, and 8K downloads</h2>
				<p>
					Free members keep 512 and 1K previews. Pro unlocks every size and format for commercial work —
					Lifetime Access from {LIFETIME_PLAN.price}, paid once.
				</p>
				<ul class="home-pro__perks">
					{
						proPerks.map((perk) => (
							<li>
								<span class="home-pro__perk-icon">
									<HomeMarkIcon name={perk.icon} />
								</span>
								<strong>{perk.title}</strong>
							</li>
						))
					}
				</ul>
				<a class="btn home-pro__cta" href="/price">See Pro plans</a>
			</div>
		</div>
	</section>

	<section class="home-tools" aria-labelledby="home-tools-title">
		<div class="section-head">
			<div>
				<p class="home-kicker home-kicker--on-light">
					<span class="home-kicker__icon"><HomeMarkIcon name="spark" /></span>
					In-browser studio
				</p>
				<h2 id="home-tools-title">Six Editing Tools, Fast and Free</h2>
				<p>Files stay on your device. No upload unless you choose visual search.</p>
			</div>
			<a class="home-section-cta" href="/tools/image">
				Open tools
				<span aria-hidden="true">→</span>
			</a>
		</div>
		<div class="home-tools__grid">
			{
				studioTools.map((tool) => (
					<a class={`home-tools__card home-tools__card--${tool.id}`} href={tool.href}>
						<span class="home-tools__shot" aria-hidden="true">
							{tool.id === 'palette' ? (
								<span class="home-tools__swatches">
									<i style="background:#c4f04b"></i>
									<i style="background:#0b0b0b"></i>
									<i style="background:#4d6b1f"></i>
									<i style="background:#d9d3c4"></i>
									<i class="home-tools__swatch-photo">
										<img src={tool.image} alt="" />
									</i>
								</span>
							) : (
								<img src={tool.image} alt="" />
							)}
							{tool.id === 'image' && (
								<span class="home-tools__crop">
									<i></i>
									<i></i>
									<i></i>
									<i></i>
								</span>
							)}
							{tool.id === 'convert' && (
								<span class="home-tools__formats">
									<b>JPG</b>
									<b>PNG</b>
									<b>WEBP</b>
								</span>
							)}
							{tool.id === 'vectorize' && (
								<svg class="home-tools__nodes" viewBox="0 0 160 90" aria-hidden="true">
									<polyline points="18,72 80,18 142,72" fill="none" stroke="currentColor" stroke-width="2"></polyline>
									<circle cx="18" cy="72" r="5"></circle>
									<circle cx="80" cy="18" r="5"></circle>
									<circle cx="142" cy="72" r="5"></circle>
								</svg>
							)}
							{tool.id === 'social' && (
								<span class="home-tools__frames">
									<i></i>
									<i></i>
									<i></i>
								</span>
							)}
							{tool.id === 'watermark' && <span class="home-tools__stamp">iStockVisual</span>}
						</span>
						<span class="home-tools__body">
							<span class="home-tools__glyph">
								<HomeMarkIcon name={tool.id} />
							</span>
							<span class="home-tools__copy">
								<h3>{tool.title}</h3>
								<p>{tool.lede}</p>
								<span class="home-tools__chips">
									{tool.chips.map((chip) => (
										<b>{chip}</b>
									))}
								</span>
							</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	{
		popularColumns.length > 0 && (
			<section class="home-bleed home-top-search" aria-labelledby="home-top-search-title">
				<div class="home-bleed__inner">
					<h2 id="home-top-search-title">Popular searches</h2>
					<div class="home-top-search__cols">
						{popularColumns.map((column) => (
							<ul>
								{column.map((keyword) => (
									<li>
										<a href={searchPath(keyword)}>{formatAssetTitle(keyword)}</a>
									</li>
								))}
							</ul>
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>
