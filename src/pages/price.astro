---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingPlans from '../components/PricingPlans';
import { LICENSE_PATH } from '../lib/seo';

const origin = Astro.url.origin;
const pageUrl = new URL('/price', origin).href;

const faqs = [
	{
		q: 'What’s included with every paid plan?',
		a: 'Every paid plan unlocks unlimited 2K, 4K, and 8K downloads in JPG, PNG, WEBP, and SVG for the duration of that plan. License terms are the same on every size: commercial and personal use, with attribution.',
	},
	{
		q: 'What’s free without paying?',
		a: 'Anyone can browse the library and download 500 and 1K previews at no cost, with or without an account. 2K, 4K, and 8K files require a Pro plan or a short-term pass.',
	},
	{
		q: 'Is Lifetime a subscription?',
		a: 'No. Lifetime Access is a one-time payment. There is no auto-renewal and no hidden fee. You keep Pro download access for as long as iStockVisual offers the library.',
	},
	{
		q: 'How do the 1-Day and 7-Day passes work?',
		a: 'A pass gives you the same Pro downloads as a longer plan, but only for that window. It is meant for a single project or a tight deadline. If you expect to come back, Lifetime is usually cheaper than stacking several short passes.',
	},
	{
		q: 'Do I have to credit iStockVisual?',
		a: 'Yes. Attribution is required, for example: Generated by iStockVisual.com. Full terms are on the license page.',
	},
	{
		q: 'Can I use images in ads, websites, and products?',
		a: 'Yes. Paid and free downloads may be used in commercial and personal work, including websites, ads, social posts, presentations, and print. You may not resell the original file as a standalone stock asset.',
	},
	{
		q: 'What happens when a short-term or term plan expires?',
		a: 'You keep files you already downloaded. New 2K, 4K, and 8K downloads lock until you renew or switch to Lifetime. 500 and 1K previews stay free.',
	},
	{
		q: 'Why is Lifetime only a little more than 12-Month Pro?',
		a: 'Twelve months is $39.99. Lifetime is $59.99 — about $20 more for downloads with no end date. Four monthly passes already cost about as much as Lifetime, which is why Long-Term is the default tab.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'FAQPage',
			'@id': `${pageUrl}#faq`,
			url: pageUrl,
			mainEntity: faqs.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.a,
				},
			})),
		},
	],
};
---

<BaseLayout
	title="Pricing"
	description="iStockVisual Pro plans: Lifetime, yearly, and flexible short-term passes for unlimited HD downloads."
	jsonLd={jsonLd}
>
	<section class="pricing-page">
		<div class="section-head">
			<div>
				<p class="asset-card__meta">Pricing</p>
				<h1>Unlimited HD downloads</h1>
				<p>
					Pick a long-term plan for the best value, or a short pass if you only need files today.
					500 and 1K previews stay free.
				</p>
			</div>
		</div>

		<PricingPlans client:load />

		<ul class="pricing-perks">
			<li>
				<strong>2K, 4K, and 8K</strong>
				<span>Unlimited HD downloads while your plan is active. Preview sizes stay free forever.</span>
			</li>
			<li>
				<strong>JPG, PNG, WEBP, SVG</strong>
				<span>Export the format your project needs. Same license on every file size.</span>
			</li>
			<li>
				<strong>Commercial use</strong>
				<span>
					Use in ads, sites, and products.{' '}
					<a href={LICENSE_PATH}>Attribution required</a>.
				</span>
			</li>
			<li>
				<strong>No auto-renewal on Lifetime</strong>
				<span>Pay once. No hidden fees. Short-term passes end on their own.</span>
			</li>
		</ul>

		<section class="pricing-compare" aria-labelledby="pricing-compare-title">
			<div class="section-head">
				<div>
					<p class="asset-card__meta">Included</p>
					<h2 id="pricing-compare-title">Free vs Pro</h2>
					<p>Every paid plan unlocks the same HD library. You only choose how long access lasts.</p>
				</div>
			</div>
			<div class="pricing-compare__table" role="table">
				<div class="pricing-compare__row pricing-compare__row--head" role="row">
					<span role="columnheader"> </span>
					<span role="columnheader">Free</span>
					<span role="columnheader">Pro / Pass</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">500 and 1K previews</span>
					<span>Yes</span>
					<span>Yes</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">2K, 4K, and 8K</span>
					<span>No</span>
					<span>Unlimited</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">JPG, PNG, WEBP, SVG</span>
					<span>Preview</span>
					<span>Full files</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">Commercial &amp; personal use</span>
					<span>Yes</span>
					<span>Yes</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">Attribution</span>
					<span>Required</span>
					<span>Required</span>
				</div>
			</div>
		</section>

		<section class="pricing-faq" aria-labelledby="pricing-faq-title">
			<div class="section-head">
				<div>
					<p class="asset-card__meta">Q&amp;A</p>
					<h2 id="pricing-faq-title">Questions and answers</h2>
					<p>Short answers on downloads, license, and why Lifetime is the default pick.</p>
				</div>
			</div>
			<div class="pricing-faq__list">
				{
					faqs.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))
				}
			</div>
		</section>
	</section>
</BaseLayout>

<style is:global>
	.pricing-page {
		width: min(100% - 2rem, 1080px);
		margin-inline: auto;
	}

	.pricing-plans {
		margin-top: 0.35rem;
	}

	.pricing-tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-tabs__tab {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.28rem;
		min-height: 3.4rem;
		padding: 0.7rem 0.85rem;
		border: 0;
		background: transparent;
		color: var(--text-muted);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.pricing-tabs__tab em {
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #fff;
		background: #c62828;
		padding: 0.12rem 0.4rem;
	}

	.pricing-tabs__tab.is-active {
		background: var(--text);
		color: var(--bg);
	}

	[data-theme='dark'] .pricing-tabs__tab.is-active {
		background: #eef3ef;
		color: #0f1412;
	}

	.pricing-switch-hint {
		margin: 0.85rem 0 0;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.pricing-switch-hint button {
		border: 0;
		padding: 0;
		background: none;
		color: var(--accent);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.pricing-switch-hint button:hover {
		text-decoration: underline;
	}

	.pricing-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 1.1rem;
		align-items: stretch;
	}

	.pricing-card {
		display: flex;
		flex-direction: column;
		padding: 1.35rem 1.2rem 1.2rem;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-card.is-featured {
		border-color: #d4a017;
		box-shadow: 0 10px 28px rgba(212, 160, 23, 0.12);
		transform: translateY(-4px);
	}

	.pricing-card__badge {
		margin: 0 0 0.55rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: #b8860b;
	}

	.pricing-card h2 {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1.08rem;
	}

	.pricing-card__amount {
		margin: 0.55rem 0 0.2rem;
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.1;
	}

	.pricing-card__amount span {
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: 0;
	}

	.pricing-card__rate {
		margin: 0 0 0.85rem;
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.pricing-card__features {
		margin: 0 0 1.15rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.4rem;
		flex: 1;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.pricing-card__features li::before {
		content: '✔ ';
		color: var(--accent);
	}

	.pricing-card .btn {
		width: 100%;
		text-align: center;
	}

	.pricing-card__note {
		margin: 0.7rem 0 0;
		color: var(--text-muted);
		font-size: 0.78rem;
		line-height: 1.45;
		text-align: center;
	}

	@media (max-width: 860px) {
		.pricing-grid {
			grid-template-columns: 1fr;
		}

		.pricing-card.is-featured {
			transform: none;
			order: -1;
		}

		.pricing-tabs__tab {
			font-size: 0.82rem;
		}
	}
</style>
