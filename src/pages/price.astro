---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingPlans from '../components/PricingPlans';
import { LICENSE_PATH, REFUNDS_PATH } from '../lib/seo';
import { FAIR_USE_POLICY, LIFETIME_PLAN, MONTH_PLAN, YEAR_PLAN } from '../lib/pricing';

const origin = Astro.url.origin;
const pageUrl = new URL('/price', origin).href;

const faqs = [
	{
		q: 'What’s included with every paid plan?',
		a: 'Every paid plan unlocks 2K, 4K, and 8K downloads in JPG, PNG, WEBP, and SVG for the duration of that plan. License terms are the same on every size: CC0, commercial and personal use, no attribution required.',
	},
	{
		q: 'What’s free without paying?',
		a: 'Anyone can browse the library and download 512 and 1K previews at no cost, with or without an account. 2K, 4K, and 8K files require a Pro plan or a short-term pass.',
	},
	{
		q: 'Is Lifetime a subscription?',
		a: 'No. Lifetime Access is a one-time payment. There is no auto-renewal and no hidden fee. You keep Pro download access for as long as iStockVisual offers the library.',
	},
	{
		q: 'How do the 1-Day and 7-Day passes work?',
		a: 'A pass gives you the same Pro downloads as a longer plan, but only for that window. It is meant for a single project or a tight deadline. If you expect to come back, Lifetime is usually cheaper than stacking several short passes.',
	},
	{
		q: 'Do I have to credit iStockVisual?',
		a: 'No. Library images are CC0. Attribution is optional. Full terms are on the license page.',
	},
	{
		q: 'Can I use images in ads, websites, and products?',
		a: 'Yes. Paid and free downloads may be used in commercial and personal work, including websites, ads, social posts, presentations, and print. You may not resell the original file as a standalone stock asset.',
	},
	{
		q: 'What happens when a short-term or term plan expires?',
		a: 'You keep files you already downloaded. New 2K, 4K, and 8K downloads lock until you renew or switch to Lifetime. 512 and 1K previews stay free.',
	},
	{
		q: 'Why is Lifetime only a little more than 12-Month Pro?',
		a: `Twelve months is ${YEAR_PLAN.price}. Lifetime is ${LIFETIME_PLAN.price} — only $40 more for downloads with no end date. A year of monthly passes (${MONTH_PLAN.price} × 12) costs far more, which is why Long-Term is the default tab.`,
	},
	{
		q: 'Can I get a refund?',
		a: '6-Month, 12-Month, and Lifetime include a 7-day trial with a no-questions-asked refund, even if you downloaded images. 1-Month Pro has a 3-day trial and refunds only if unused. 1-Day and 7-Day passes refund only if you have not downloaded any images.',
		href: REFUNDS_PATH,
		linkLabel: 'Read the Refund Policy',
	},
	{
		q: 'What is the Fair Use Policy?',
		a: FAIR_USE_POLICY,
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'FAQPage',
			'@id': `${pageUrl}#faq`,
			url: pageUrl,
			mainEntity: faqs.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'href' in item && item.href ? `${item.a} ${item.linkLabel}.` : item.a,
				},
			})),
		},
	],
};
---

<BaseLayout
	title="Pricing"
	description="iStockVisual Pro plans: Lifetime Access, yearly, and flexible short-term passes for 2K, 4K, and 8K downloads."
	jsonLd={jsonLd}
>
	<section class="pricing-page">
		<div class="section-head">
			<div>
				<p class="asset-card__meta">Pricing</p>
				<h1>Pro downloads for every project</h1>
				<p>
					Pick a long-term plan for the best value, or a short pass if you only need files today.
					512 and 1K previews stay free.
				</p>
			</div>
		</div>

		<PricingPlans client:load />

		<ul class="pricing-perks">
			<li>
				<strong>2K, 4K, and 8K</strong>
				<span>High-resolution downloads while your plan is active. Preview sizes stay free forever.</span>
			</li>
			<li>
				<strong>JPG, PNG, WEBP, SVG</strong>
				<span>Export the format your project needs. Same license on every file size.</span>
			</li>
			<li>
				<strong>Commercial use</strong>
				<span>
					Use in ads, sites, and products.{' '}
					<a href={LICENSE_PATH}>CC0 License</a> — no attribution required.
				</span>
			</li>
			<li>
				<strong>No auto-renewal on Lifetime</strong>
				<span>One-time charge. No hidden fees. Short-term passes end on their own.</span>
			</li>
		</ul>

		<section class="pricing-compare" aria-labelledby="pricing-compare-title">
			<div class="section-head">
				<div>
					<p class="asset-card__meta">Included</p>
					<h2 id="pricing-compare-title">Free vs Pro</h2>
					<p>Every paid plan unlocks the same HD library. You only choose how long access lasts.</p>
				</div>
			</div>
			<div class="pricing-compare__table" role="table">
				<div class="pricing-compare__row pricing-compare__row--head" role="row">
					<span role="columnheader"> </span>
					<span role="columnheader">Free</span>
					<span role="columnheader">Pro / Pass</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">512 and 1K previews</span>
					<span>Yes</span>
					<span>Yes</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">2K, 4K, and 8K</span>
					<span>No</span>
					<span>Yes</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">JPG, PNG, WEBP, SVG</span>
					<span>Preview</span>
					<span>Full files</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">Commercial &amp; personal use</span>
					<span>Yes</span>
					<span>Yes</span>
				</div>
				<div class="pricing-compare__row" role="row">
					<span role="rowheader">Attribution</span>
					<span>Not required (CC0)</span>
					<span>Not required (CC0)</span>
				</div>
			</div>
		</section>

		<section class="pricing-faq" aria-labelledby="pricing-faq-title">
			<div class="section-head">
				<div>
					<p class="asset-card__meta">Q&amp;A</p>
					<h2 id="pricing-faq-title">Questions and answers</h2>
					<p>Short answers on downloads, license, and why Lifetime is the default pick.</p>
				</div>
			</div>
			<div class="pricing-faq__list">
				{
					faqs.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>
								{item.a}
								{'href' in item && item.href ? (
									<>
										{' '}
										<a href={item.href}>{item.linkLabel}</a>.
									</>
								) : null}
							</p>
						</details>
					))
				}
			</div>
		</section>
	</section>
</BaseLayout>

<style is:global>
	.pricing-page {
		width: min(100% - 2rem, 1080px);
		margin-inline: auto;
	}

	.pricing-plans {
		margin-top: 0.35rem;
	}

	.pricing-tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-tabs__tab {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.28rem;
		min-height: 3.4rem;
		padding: 0.7rem 0.85rem;
		border: 0;
		background: transparent;
		color: var(--text-muted);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.pricing-tabs__tab em {
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #fff;
		background: #c62828;
		padding: 0.12rem 0.4rem;
	}

	.pricing-tabs__tab.is-active {
		background: var(--text);
		color: var(--bg);
	}

	[data-theme='dark'] .pricing-tabs__tab.is-active {
		background: #eef3ef;
		color: #0f1412;
	}

	.pricing-switch-hint {
		margin: 0.85rem 0 0;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.pricing-switch-hint button {
		border: 0;
		padding: 0;
		background: none;
		color: var(--accent);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.pricing-switch-hint button:hover {
		text-decoration: underline;
	}

	.pricing-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-rows: auto auto auto auto auto auto auto 1fr auto;
		margin-top: 1.35rem;
		align-items: center;
	}

	.pricing-card {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: span 9;
		padding: 1.15rem 1.2rem 1.25rem;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
		border-radius: 1.15rem;
		min-height: 100%;
	}

	.pricing-card.is-featured {
		border-color: #d4a017;
		box-shadow: 0 18px 40px rgba(15, 20, 18, 0.12);
		padding-top: 1.35rem;
		padding-bottom: 1.55rem;
		z-index: 1;
	}

	.pricing-card__badge {
		margin: 0 auto 0.55rem;
		width: fit-content;
		min-height: 1.45rem;
		padding: 0.18rem 0.7rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #fff;
		background: #c62828;
	}

	.pricing-card__badge.is-empty {
		visibility: hidden;
		background: transparent;
		padding: 0;
	}

	.pricing-card h2 {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1.12rem;
		text-align: center;
	}

	.pricing-card__amount {
		display: flex;
		align-items: baseline;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.28rem 0.5rem;
		margin: 0.7rem 0 0;
		font-size: 2.15rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.05;
	}

	.pricing-card__amount strong {
		font-weight: 700;
	}

	.pricing-card__amount del {
		font-size: 1.05rem;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: 0;
	}

	.pricing-card__amount span {
		max-width: 6.5rem;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: 0;
		line-height: 1.3;
		text-align: left;
	}

	.pricing-card__rate {
		margin: 0.35rem 0 0;
		color: var(--text-muted);
		font-size: 0.84rem;
		text-align: center;
	}

	.pricing-card__desc {
		margin: 0.7rem 0 0;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.5;
		text-align: center;
		min-height: 4.2em;
	}

	.pricing-card__highlight {
		margin: 0.45rem 0 0;
		color: #b8860b;
		font-size: 0.82rem;
		font-weight: 700;
		text-align: center;
	}

	.pricing-card__highlight.is-empty {
		visibility: hidden;
	}

	.pricing-card .btn {
		width: 100%;
		margin-top: 0.85rem;
		text-align: center;
		border-radius: 999px;
	}

	.pricing-card__includes {
		margin: 1.05rem 0 0.45rem;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.pricing-card__features {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		align-content: start;
		gap: 0.55rem;
		color: var(--text);
		font-size: 0.86rem;
		line-height: 1.4;
	}

	.pricing-card__features li {
		display: grid;
		grid-template-columns: 1.1rem minmax(0, 1fr) 1rem;
		gap: 0.4rem;
		align-items: start;
	}

	.pricing-card__check {
		color: var(--accent);
		font-weight: 700;
		line-height: 1.35;
	}

	.pricing-card__info {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 0.95rem;
		height: 0.95rem;
		margin-top: 0.12rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--text-muted);
		font-size: 0.62rem;
		font-weight: 700;
		font-style: italic;
		line-height: 1;
		cursor: help;
	}

	.pricing-card__note {
		margin: 0.75rem 0 0;
		color: var(--text-muted);
		font-size: 0.78rem;
		line-height: 1.45;
		text-align: left;
	}

	.pricing-trust {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
	}

	.pricing-trust li {
		display: grid;
		gap: 0.28rem;
		padding: 0.95rem 1rem;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-trust strong {
		font-size: 0.9rem;
	}

	.pricing-trust span {
		color: var(--text-muted);
		font-size: 0.84rem;
		line-height: 1.5;
	}

	.pricing-trust__why {
		margin: 0.9rem 0 0;
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.55;
		text-align: center;
		font-style: italic;
	}

	.pricing-perks {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.pricing-perks li {
		display: grid;
		gap: 0.35rem;
		padding: 1.05rem 1rem;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-perks strong {
		font-size: 0.92rem;
	}

	.pricing-perks span,
	.pricing-perks a {
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.5;
	}

	.pricing-perks a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.pricing-compare .section-head,
	.pricing-faq .section-head {
		margin-bottom: 0.85rem;
	}

	.pricing-compare__table {
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-compare__row {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 0.8fr);
		gap: 0.75rem;
		padding: 0.8rem 1rem;
		border-top: 1px solid var(--line);
		font-size: 0.9rem;
	}

	.pricing-compare__row:first-child {
		border-top: 0;
	}

	.pricing-compare__row--head {
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.pricing-compare__row span:last-child {
		font-weight: 600;
	}

	.pricing-faq__list {
		display: grid;
		border: 1px solid var(--line);
		background: var(--panel-bg, #fff);
	}

	.pricing-faq__list details {
		border-top: 1px solid var(--line);
	}

	.pricing-faq__list details:first-child {
		border-top: 0;
	}

	.pricing-faq__list summary {
		cursor: pointer;
		list-style: none;
		padding: 0.95rem 1.05rem;
		font-weight: 600;
	}

	.pricing-faq__list summary::-webkit-details-marker {
		display: none;
	}

	.pricing-faq__list summary::after {
		content: '+';
		float: right;
		color: var(--text-muted);
		font-weight: 500;
	}

	.pricing-faq__list details[open] summary::after {
		content: '–';
	}

	.pricing-faq__list p {
		margin: 0;
		padding: 0 1.05rem 1rem;
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 62ch;
	}

	.pricing-faq__list a {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	@media (max-width: 860px) {
		.pricing-grid {
			grid-template-columns: 1fr;
		}

		.pricing-card.is-featured {
			transform: none;
			order: -1;
		}

		.pricing-tabs__tab {
			font-size: 0.82rem;
		}

		.pricing-perks {
			grid-template-columns: 1fr 1fr;
		}

		.pricing-trust {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.pricing-perks,
		.pricing-compare__row {
			grid-template-columns: 1fr;
		}

		.pricing-compare__row--head {
			display: none;
		}

		.pricing-compare__row span:nth-child(2)::before {
			content: 'Free · ';
			color: var(--text-muted);
			font-weight: 500;
		}

		.pricing-compare__row span:last-child::before {
			content: 'Pro / Pass · ';
			color: var(--text-muted);
			font-weight: 500;
		}
	}
</style>
