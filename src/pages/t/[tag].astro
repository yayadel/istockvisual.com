---
import { fromPathSlug, searchPath, toPathSlug } from '../../lib/paths';

const raw = Astro.params.tag;
if (!raw) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const tagSlug = decodeURIComponent(raw);
const label = fromPathSlug(tagSlug);
const target = searchPath(toPathSlug(label) ? label : tagSlug);
return Astro.redirect(target, 301);
---
