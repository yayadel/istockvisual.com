---
import { searchPath } from '../lib/paths';

const q = (Astro.url.searchParams.get('q') || '').trim();
const category = Astro.url.searchParams.get('category') || 'all';
const rest = new URLSearchParams(Astro.url.searchParams);
rest.delete('q');
rest.delete('category');

if (q) {
	const target = new URL(searchPath(q, category), Astro.url.origin);
	for (const [key, value] of rest.entries()) {
		target.searchParams.set(key, value);
	}
	return Astro.redirect(target.pathname + target.search, 301);
}

const fallback = rest.toString() ? `/s/?${rest.toString()}` : '/s/';
return Astro.redirect(fallback, 301);
