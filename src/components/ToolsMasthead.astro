---
interface Props {
	title: string;
	lede: string;
	privacy: string;
	active: 'image' | 'convert' | 'vectorize' | 'social' | 'watermark' | 'palette';
}

const { title, lede, privacy, active } = Astro.props;

const links = [
	{ id: 'image', href: '/tools/image', label: 'Image Editor', hint: 'Adjust · Crop · BG' },
	{ id: 'convert', href: '/tools/convert', label: 'Image Convert', hint: 'Format · Batch' },
	{ id: 'vectorize', href: '/tools/vectorize', label: 'Image Vectorizer', hint: 'Bitmap → SVG' },
	{ id: 'social', href: '/tools/social', label: 'Social Resizer', hint: 'Platform sizes' },
	{ id: 'watermark', href: '/tools/watermark', label: 'Batch Watermark', hint: 'Text · Logo' },
	{ id: 'palette', href: '/tools/palette', label: 'Palette Generator', hint: 'Extract colors' },
] as const;

const current = links.find((link) => link.id === active) ?? links[0];
const currentIndex = String(links.findIndex((link) => link.id === active) + 1).padStart(2, '0');
---

<header class="tools-masthead">
	<div class="tools-masthead__picker" data-tools-picker>
		<p class="tools-masthead__current">
			<span>{currentIndex}</span>
			<strong>{current.label}</strong>
		</p>
		<details class="tools-masthead__more">
			<summary>
				Other tools
				<span class="tools-masthead__more-caret" aria-hidden="true"></span>
			</summary>
			<div class="tools-masthead__menu" role="menu">
				{
					links.map((link, index) => (
						<a
							href={link.href}
							role="menuitem"
							aria-current={active === link.id ? 'page' : undefined}
						>
							<span class="tools-masthead__tab-index">{String(index + 1).padStart(2, '0')}</span>
							<span class="tools-masthead__tab-copy">
								<strong>{link.label}</strong>
								<em>{link.hint}</em>
							</span>
						</a>
					))
				}
			</div>
		</details>
	</div>
	<nav class="tools-masthead__switch" aria-label="Tools">
		{
			links.map((link, index) => (
				<a
					class:list={['tools-masthead__tab', active === link.id && 'is-active']}
					href={link.href}
					aria-current={active === link.id ? 'page' : undefined}
				>
					<span class="tools-masthead__tab-index">{String(index + 1).padStart(2, '0')}</span>
					<span class="tools-masthead__tab-copy">
						<strong>{link.label}</strong>
						<em>{link.hint}</em>
					</span>
				</a>
			))
		}
	</nav>
	<h1 class="tools-masthead__title">{title}</h1>
	<p class="tools-masthead__lede">{lede}</p>
	<p class="tools-masthead__privacy">{privacy}</p>
</header>

<script>
	document.querySelectorAll('[data-tools-picker]').forEach(function (root) {
		var details = root.querySelector('details');
		if (!(details instanceof HTMLDetailsElement)) return;

		document.addEventListener('mousedown', function (event) {
			if (!details.open) return;
			if (event.target instanceof Node && !details.contains(event.target)) {
				details.open = false;
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') details.open = false;
		});
	});
</script>
