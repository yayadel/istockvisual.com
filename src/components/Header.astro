---
import { CATEGORIES } from '../config/categories';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { isAdminUser } from '../lib/admin';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
const path = Astro.url.pathname;
const isHome = path === '/';
const isAdmin = isAdminUser(user, env);
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/">iStock<span>Visual</span></a>
		<nav class="nav" aria-label="Primary">
			{
				CATEGORIES.map((category) => (
					<a
						href={`/${category.slug}`}
						aria-current={path.startsWith(`/${category.slug}`) ? 'page' : undefined}
					>
						{category.label}
					</a>
				))
			}
			<a
				class="nav__ai"
				href="/tools/ai-edit"
				aria-current={path.startsWith('/tools/ai-edit') ? 'page' : undefined}
			>
				<span class="nav__ai-icon" aria-hidden="true">✦</span>
				AI Tools
			</a>
			<a href="/tools/generate" aria-current={path === '/tools/generate' ? 'page' : undefined}>
				Generate
			</a>
			{
				isAdmin && (
					<a href="/admin" aria-current={path.startsWith('/admin') ? 'page' : undefined}>
						Admin
					</a>
				)
			}
			<div class="nav__spacer" aria-hidden="true"></div>
			<ThemeToggle />
			{
				user ? (
					<a class="nav__cta" href="/account">
						{user.name || 'Account'}
					</a>
				) : (
					<a class="nav__signin" href="/login">
						Sign in
					</a>
				)
			}
		</nav>
	</div>
</header>

{
	!isHome && (
		<div class="search-strip">
			<div class="search-strip__inner">
				<SearchBar variant="bar" />
			</div>
		</div>
	)
}
