---
import { visibleNavCategories } from '../config/categories';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { isAdminUser } from '../lib/admin';
import { contentCategoryPath, getContentCategoryIntro } from '../lib/content-categories';
import { listPopulatedMediaTypes, listTopContentCategoriesByCount } from '../lib/generated-assets';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
const path = Astro.url.pathname;
const isHome = path === '/';
const isAdmin = isAdminUser(user, env);
const toolsActive = path.startsWith('/tools/');
const categoriesActive = path === '/c' || path.startsWith('/c/');
const priceActive = path === '/price';
const topCategories = (await listTopContentCategoriesByCount(env.DB, 10)).map((item, index) => {
	const intro = getContentCategoryIntro(item.label);
	return {
		...item,
		index: String(index + 1).padStart(2, '0'),
		lede: intro.lede,
		hint: intro.hint,
		href: contentCategoryPath(item.slug),
	};
});
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/">iStock<span>Visual</span></a>
		<div class="header-auth">
			{
				user ? (
					<a class="header-auth__account" href="/account">
						{user.name || 'Account'}
					</a>
				) : (
					<>
						<a class="header-auth__login" href="/login">
							Log in
						</a>
						<a class="header-auth__signup" href="/signup">
							Sign up
						</a>
					</>
				)
			}
		</div>
		<button
			class="nav-toggle"
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="site-nav"
			data-nav-toggle
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="nav-backdrop" hidden data-nav-backdrop></div>
		<nav class="nav" id="site-nav" aria-label="Primary">
			{
				CATEGORIES.map((category) => (
					<a
						href={`/${category.slug}`}
						aria-current={path.startsWith(`/${category.slug}`) ? 'page' : undefined}
					>
						{category.label}
					</a>
				))
			}
			<div class="nav__dropdown nav__dropdown--categories" data-nav-dropdown>
				<button
					type="button"
					class="nav__dropdown-trigger"
					aria-expanded="false"
					aria-haspopup="true"
					aria-controls="nav-categories-menu"
					data-nav-dropdown-trigger
					aria-current={categoriesActive ? 'page' : undefined}
				>
					Categories
					<span class="nav__dropdown-caret" aria-hidden="true"></span>
				</button>
				<div
					id="nav-categories-menu"
					class="nav__categories-mega"
					hidden
					data-nav-dropdown-menu
				>
					<div class="nav__categories-mega__preview" aria-live="polite">
						{
							topCategories.map((item, i) => (
								<article
									class:list={['nav__categories-mega__panel', i === 0 && 'is-active']}
									data-categories-panel={item.slug}
									hidden={i !== 0}
								>
									<p class="nav__categories-mega__index">{item.index}</p>
									<h3 class="nav__categories-mega__title">{item.label}</h3>
									<p class="nav__categories-mega__lede">{item.lede}</p>
									<p class="nav__categories-mega__hint">{item.hint}</p>
									<a class="nav__categories-mega__cta" href={item.href}>
										Browse category
										<span aria-hidden="true">→</span>
									</a>
								</article>
							))
						}
					</div>
					<div class="nav__categories-mega__list" role="menu">
						<p class="nav__categories-mega__list-label">Top categories</p>
						{
							topCategories.map((item) => (
								<a
									href={item.href}
									role="menuitem"
									data-categories-item={item.slug}
									aria-current={path === `/c/${item.slug}` ? 'page' : undefined}
								>
									<span>{item.label}</span>
									<em>{item.index}</em>
								</a>
							))
						}
						<a class="nav__categories-mega__all" href="/c/" role="menuitem">
							All Categories
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
			<div class="nav__dropdown nav__dropdown--tools" data-nav-dropdown>
				<button
					type="button"
					class="nav__dropdown-trigger"
					aria-expanded="false"
					aria-haspopup="true"
					aria-controls="nav-tool-menu"
					data-nav-dropdown-trigger
					aria-current={toolsActive ? 'page' : undefined}
				>
					Tool
					<span class="nav__dropdown-caret" aria-hidden="true"></span>
				</button>
				<div
					id="nav-tool-menu"
					class="nav__tools-mega"
					hidden
					data-nav-dropdown-menu
				>
					<div class="nav__tools-mega__preview" aria-live="polite">
						{
							[
								{
									id: 'image',
									index: '01',
									title: 'Image Editor',
									lede: 'Adjust, crop, remove backgrounds, and expand photos entirely in the browser — private and free.',
									href: '/tools/image',
									hint: 'Adjust · Crop · Remove BG · Expand',
								},
								{
									id: 'convert',
									index: '02',
									title: 'Image Convert',
									lede: 'Batch convert JPG, PNG, WebP, and HEIC with quality, scale, and max-width controls. EXIF is stripped locally.',
									href: '/tools/convert',
									hint: 'Format · Quality · Batch ZIP',
								},
								{
									id: 'vectorize',
									index: '03',
									title: 'Image Vectorizer',
									lede: 'Trace bitmaps into clean SVG paths. Tune colors, blur, and detail, then copy code or download the file.',
									href: '/tools/vectorize',
									hint: 'Bitmap → SVG · Local trace',
								},
								{
									id: 'social',
									index: '04',
									title: 'Social Resizer',
									lede: 'Fit one batch to Instagram, TikTok, YouTube, Facebook, and LinkedIn — cover crop or soft blur pad.',
									href: '/tools/social',
									hint: 'Presets · Focus · ZIP export',
								},
								{
									id: 'watermark',
									index: '05',
									title: 'Batch Watermark',
									lede: 'Stamp text or logo marks that scale with each photo. Nine-point placement or diagonal tile for protection.',
									href: '/tools/watermark',
									hint: 'Text · Logo · Tile pattern',
								},
								{
									id: 'palette',
									index: '06',
									title: 'Palette Generator',
									lede: 'Extract dominant colors with median cut. Copy HEX, RGB, or HSL, export CSS / Tailwind, or a share card.',
									href: '/tools/palette',
									hint: 'Swatches · Eyedropper · Export',
								},
							].map((tool, i) => (
								<article
									class:list={['nav__tools-mega__panel', i === 0 && 'is-active']}
									data-tools-panel={tool.id}
									hidden={i !== 0}
								>
									<p class="nav__tools-mega__index">{tool.index}</p>
									<h3 class="nav__tools-mega__title">{tool.title}</h3>
									<p class="nav__tools-mega__lede">{tool.lede}</p>
									<p class="nav__tools-mega__hint">{tool.hint}</p>
									<a class="nav__tools-mega__cta" href={tool.href}>
										Open tool
										<span aria-hidden="true">→</span>
									</a>
								</article>
							))
						}
					</div>
					<div class="nav__tools-mega__list" role="menu">
						<p class="nav__tools-mega__list-label">Tools</p>
						<a
							href="/tools/image"
							role="menuitem"
							data-tools-item="image"
							aria-current={path.startsWith('/tools/image') ? 'page' : undefined}
						>
							<span>Image Editor</span>
							<em>01</em>
						</a>
						<a
							href="/tools/convert"
							role="menuitem"
							data-tools-item="convert"
							aria-current={path.startsWith('/tools/convert') ? 'page' : undefined}
						>
							<span>Image Convert</span>
							<em>02</em>
						</a>
						<a
							href="/tools/vectorize"
							role="menuitem"
							data-tools-item="vectorize"
							aria-current={path.startsWith('/tools/vectorize') ? 'page' : undefined}
						>
							<span>Image Vectorizer</span>
							<em>03</em>
						</a>
						<a
							href="/tools/social"
							role="menuitem"
							data-tools-item="social"
							aria-current={path.startsWith('/tools/social') ? 'page' : undefined}
						>
							<span>Social Resizer</span>
							<em>04</em>
						</a>
						<a
							href="/tools/watermark"
							role="menuitem"
							data-tools-item="watermark"
							aria-current={path.startsWith('/tools/watermark') ? 'page' : undefined}
						>
							<span>Batch Watermark</span>
							<em>05</em>
						</a>
						<a
							href="/tools/palette"
							role="menuitem"
							data-tools-item="palette"
							aria-current={path.startsWith('/tools/palette') ? 'page' : undefined}
						>
							<span>Palette Generator</span>
							<em>06</em>
						</a>
					</div>
				</div>
			</div>
			<a href="/price" aria-current={priceActive ? 'page' : undefined}>
				Price
			</a>
			{
				isAdmin && (
					<a href="/admin" aria-current={path.startsWith('/admin') ? 'page' : undefined}>
						Admin
					</a>
				)
			}
			<div class="nav__spacer" aria-hidden="true"></div>
			<ThemeToggle />
			<div class="nav__auth">
				{
					user ? (
						<a class="nav__cta" href="/account">
							{user.name || 'Account'}
						</a>
					) : (
						<>
							<a class="nav__signin" href="/login">
								Log in
							</a>
							<a class="nav__signup" href="/signup">
								Sign up
							</a>
						</>
					)
				}
			</div>
		</nav>
	</div>
</header>

{
	!isHome && (
		<div class="search-strip">
			<div class="search-strip__inner">
				<SearchBar variant="bar" />
			</div>
		</div>
	)
}

<script>
	var navCloseTimer = null;
	var navQuery = window.matchMedia('(max-width: 960px)');

	function isMobileNav() {
		return navQuery.matches;
	}

	function setMobileNavOpen(open) {
		var toggle = document.querySelector('[data-nav-toggle]');
		var backdrop = document.querySelector('[data-nav-backdrop]');
		document.body.classList.toggle('nav-open', open);
		if (toggle) {
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		}
		if (backdrop) backdrop.hidden = !open;
		if (!open) closeAllNavDropdowns();
	}

	function closeAllNavDropdowns(except) {
		document.querySelectorAll('[data-nav-dropdown]').forEach(function (root) {
			if (except && root === except) return;
			var menu = root.querySelector('[data-nav-dropdown-menu]');
			var trigger = root.querySelector('[data-nav-dropdown-trigger]');
			if (menu) menu.hidden = true;
			if (trigger) trigger.setAttribute('aria-expanded', 'false');
			root.classList.remove('is-open');
		});
	}

	function openNavDropdown(root) {
		if (!root) return;
		if (navCloseTimer) {
			clearTimeout(navCloseTimer);
			navCloseTimer = null;
		}
		var menu = root.querySelector('[data-nav-dropdown-menu]');
		var trigger = root.querySelector('[data-nav-dropdown-trigger]');
		if (!menu || !trigger) return;
		closeAllNavDropdowns(root);
		menu.hidden = false;
		trigger.setAttribute('aria-expanded', 'true');
		root.classList.add('is-open');
		if (menu.classList.contains('nav__tools-mega')) {
			activateToolsPanel(menu, defaultToolsId(menu));
		}
		if (menu.classList.contains('nav__categories-mega')) {
			activateCategoriesPanel(menu, defaultCategoriesId(menu));
		}
	}

	function scheduleCloseNavDropdown(root) {
		if (navCloseTimer) clearTimeout(navCloseTimer);
		navCloseTimer = setTimeout(function () {
			if (root && root.matches(':hover')) return;
			closeAllNavDropdowns();
			navCloseTimer = null;
		}, 160);
	}

	function activateToolsPanel(menu, id) {
		if (!menu || !id) return;
		menu.querySelectorAll('[data-tools-panel]').forEach(function (panel) {
			var on = panel.getAttribute('data-tools-panel') === id;
			panel.hidden = !on;
			panel.classList.toggle('is-active', on);
		});
		menu.querySelectorAll('[data-tools-item]').forEach(function (item) {
			item.classList.toggle('is-active', item.getAttribute('data-tools-item') === id);
		});
	}

	function defaultToolsId(menu) {
		var current = menu.querySelector('[data-tools-item][aria-current="page"]');
		if (current) return current.getAttribute('data-tools-item');
		var first = menu.querySelector('[data-tools-item]');
		return first ? first.getAttribute('data-tools-item') : 'image';
	}

	function activateCategoriesPanel(menu, id) {
		if (!menu || !id) return;
		menu.querySelectorAll('[data-categories-panel]').forEach(function (panel) {
			var on = panel.getAttribute('data-categories-panel') === id;
			panel.hidden = !on;
			panel.classList.toggle('is-active', on);
		});
		menu.querySelectorAll('[data-categories-item]').forEach(function (item) {
			item.classList.toggle('is-active', item.getAttribute('data-categories-item') === id);
		});
	}

	function defaultCategoriesId(menu) {
		var current = menu.querySelector('[data-categories-item][aria-current="page"]');
		if (current) return current.getAttribute('data-categories-item');
		var first = menu.querySelector('[data-categories-item]');
		return first ? first.getAttribute('data-categories-item') : null;
	}

	document.querySelectorAll('[data-nav-dropdown]').forEach(function (root) {
		root.addEventListener('pointerenter', function () {
			if (isMobileNav()) return;
			openNavDropdown(root);
		});
		root.addEventListener('pointerleave', function () {
			if (isMobileNav()) return;
			scheduleCloseNavDropdown(root);
		});
	});

	document.addEventListener('click', function (event) {
		var target = event.target;
		if (!(target instanceof Element)) return;

		if (target.closest('[data-nav-toggle]')) {
			event.preventDefault();
			setMobileNavOpen(!document.body.classList.contains('nav-open'));
			return;
		}

		if (target.closest('[data-nav-backdrop]')) {
			setMobileNavOpen(false);
			return;
		}

		var trigger = target.closest('[data-nav-dropdown-trigger]');
		if (trigger) {
			var root = trigger.closest('[data-nav-dropdown]');
			var menu = root && root.querySelector('[data-nav-dropdown-menu]');
			if (!root || !menu) return;
			event.preventDefault();
			if (menu.hidden) {
				openNavDropdown(root);
			} else {
				closeAllNavDropdowns();
			}
			return;
		}

		if (!target.closest('[data-nav-dropdown]') && !isMobileNav()) {
			closeAllNavDropdowns();
		}
	});

	document.addEventListener('pointerover', function (event) {
		var target = event.target;
		if (!(target instanceof Element)) return;

		var toolsItem = target.closest('[data-tools-item]');
		if (toolsItem) {
			var toolsMenu = toolsItem.closest('.nav__tools-mega');
			if (toolsMenu && !toolsMenu.hidden) {
				activateToolsPanel(toolsMenu, toolsItem.getAttribute('data-tools-item'));
			}
		}

		var catItem = target.closest('[data-categories-item]');
		if (catItem) {
			var catMenu = catItem.closest('.nav__categories-mega');
			if (catMenu && !catMenu.hidden) {
				activateCategoriesPanel(catMenu, catItem.getAttribute('data-categories-item'));
			}
		}
	});

	document.addEventListener('focusin', function (event) {
		var target = event.target;
		if (!(target instanceof Element)) return;

		var toolsItem = target.closest('[data-tools-item]');
		if (toolsItem) {
			var toolsMenu = toolsItem.closest('.nav__tools-mega');
			if (toolsMenu && !toolsMenu.hidden) {
				activateToolsPanel(toolsMenu, toolsItem.getAttribute('data-tools-item'));
			}
		}

		var catItem = target.closest('[data-categories-item]');
		if (catItem) {
			var catMenu = catItem.closest('.nav__categories-mega');
			if (catMenu && !catMenu.hidden) {
				activateCategoriesPanel(catMenu, catItem.getAttribute('data-categories-item'));
			}
		}
	});

	document.addEventListener('keydown', function (event) {
		if (event.key === 'Escape') {
			closeAllNavDropdowns();
			setMobileNavOpen(false);
		}
	});

	navQuery.addEventListener('change', function () {
		if (!navQuery.matches) setMobileNavOpen(false);
	});
</script>
