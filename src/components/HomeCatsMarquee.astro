---
type Tile = {
	href: string;
	image: string;
	label: string;
};

type Props = {
	tiles: Tile[];
	label: string;
};

const { tiles, label } = Astro.props;
const duration = Math.max(48, tiles.length * 3.2);
const payload = JSON.stringify(tiles).replace(/</g, '\\u003c');
---

{
	tiles.length > 0 && (
		<section class="home-bleed home-cats" aria-label={label} data-cats-duration={duration}>
			<script type="application/json" set:html={payload} />
			<div class="home-cats__viewport" data-cats-scroller>
				<div class="home-cats__track"></div>
			</div>
		</section>
	)
}

<script src="/js/home-cats-marquee.js?v=5" defer></script>
