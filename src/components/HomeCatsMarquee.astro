---
type Tile = {
	href: string;
	image: string;
	label: string;
};

type Props = {
	tiles: Tile[];
	label: string;
};

const { tiles, label } = Astro.props;
const duration = Math.max(48, tiles.length * 3.2);
---

{
	tiles.length > 0 && (
		<section class="home-bleed home-cats" aria-label={label} data-cats-duration={duration}>
			<div class="home-cats__viewport" data-cats-scroller>
				<div class="home-cats__track">
					<div class="home-cats__group">
						{tiles.map((category) => (
							<a class="home-cats__card" href={category.href}>
								<img src={category.image} alt="" draggable="false" decoding="async" />
								<span class="home-cats__label">{category.label}</span>
							</a>
						))}
					</div>
					<div class="home-cats__group" aria-hidden="true">
						{tiles.map((category) => (
							<a class="home-cats__card" href={category.href} tabindex={-1}>
								<img src={category.image} alt="" draggable="false" decoding="async" />
								<span class="home-cats__label">{category.label}</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	)
}

<script is:inline>
	(function () {
		if (window.__istockCatsMarquee) return;
		window.__istockCatsMarquee = true;

		function setup(root) {
			if (root.getAttribute('data-cats-ready')) return;
			root.setAttribute('data-cats-ready', '1');

			var scroller = root.querySelector('[data-cats-scroller]');
			var group = root.querySelector('.home-cats__group');
			if (!scroller || !group) return;

			var duration = parseFloat(root.getAttribute('data-cats-duration')) || 48;
			var userHold = false;
			var resumeAt = 0;
			var dragging = false;
			var moved = 0;
			var pointerId = null;
			var startX = 0;
			var startScroll = 0;
			var wrapping = false;
			var fromAuto = false;
			var IDLE_MS = 4000;

			function loopW() {
				return group.scrollWidth || group.offsetWidth || 0;
			}

			function wrap() {
				var w = loopW();
				if (w < 8 || wrapping) return;
				var x = scroller.scrollLeft;
				if (x >= w) {
					wrapping = true;
					scroller.scrollLeft = x - w;
					wrapping = false;
				} else if (x < 0) {
					wrapping = true;
					scroller.scrollLeft = x + w;
					wrapping = false;
				}
			}

			function hold() {
				userHold = true;
				resumeAt = Number.POSITIVE_INFINITY;
			}

			function release() {
				userHold = false;
				resumeAt = Date.now() + IDLE_MS;
			}

			function canAutoMove() {
				return !userHold && !dragging && Date.now() >= resumeAt;
			}

			function tick() {
				if (canAutoMove()) {
					var w = loopW();
					if (w > 8) {
						fromAuto = true;
						scroller.scrollLeft += Math.max(0.35, w / duration / 60);
						wrap();
						fromAuto = false;
					}
				}
				requestAnimationFrame(tick);
			}
			requestAnimationFrame(tick);

			scroller.addEventListener(
				'scroll',
				function () {
					if (!fromAuto && !wrapping) resumeAt = Date.now() + IDLE_MS;
					wrap();
				},
				{ passive: true }
			);

			scroller.addEventListener('pointerdown', function (event) {
				if (event.button !== 0) return;
				hold();
				moved = 0;
				if (event.pointerType === 'touch' || event.pointerType === 'pen') return;

				dragging = true;
				pointerId = event.pointerId;
				startX = event.clientX;
				startScroll = scroller.scrollLeft;
				root.classList.add('is-grabbing');
				try {
					scroller.setPointerCapture(event.pointerId);
				} catch (err) {}
			});

			scroller.addEventListener('pointermove', function (event) {
				if (!dragging || event.pointerId !== pointerId) return;
				var dx = event.clientX - startX;
				moved = Math.max(moved, Math.abs(dx));
				if (moved < 3) return;
				root.classList.add('is-dragging');
				fromAuto = true;
				scroller.scrollLeft = startScroll - dx;
				wrap();
				fromAuto = false;
			});

			function endDrag(event) {
				if (pointerId != null && event && event.pointerId !== pointerId && event.type !== 'pointercancel') {
					return;
				}
				dragging = false;
				pointerId = null;
				root.classList.remove('is-grabbing');
				window.setTimeout(function () {
					root.classList.remove('is-dragging');
				}, 80);
				release();
			}

			scroller.addEventListener('pointerup', endDrag);
			scroller.addEventListener('pointercancel', endDrag);
			scroller.addEventListener('lostpointercapture', endDrag);

			scroller.addEventListener(
				'touchstart',
				function () {
					hold();
				},
				{ passive: true }
			);
			scroller.addEventListener(
				'touchend',
				function () {
					release();
					wrap();
				},
				{ passive: true }
			);
			scroller.addEventListener(
				'touchcancel',
				function () {
					release();
				},
				{ passive: true }
			);

			scroller.addEventListener(
				'click',
				function (event) {
					if (moved < 6) return;
					event.preventDefault();
					event.stopPropagation();
				},
				true
			);
			scroller.addEventListener('dragstart', function (event) {
				event.preventDefault();
			});
		}

		function boot() {
			document.querySelectorAll('.home-cats').forEach(setup);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
		document.addEventListener('astro:page-load', boot);
	})();
</script>
