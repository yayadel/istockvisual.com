---
type Tile = {
	href: string;
	image: string;
	label: string;
};

type Props = {
	tiles: Tile[];
	label: string;
};

const { tiles, label } = Astro.props;
const duration = Math.max(48, tiles.length * 3.2);
---

{
	tiles.length > 0 && (
		<section class="home-bleed home-cats" aria-label={label} data-cats-duration={duration}>
			<div class="home-cats__viewport" data-cats-scroller>
				<div class="home-cats__track">
					{[0, 1].map((copy) => (
						<div class="home-cats__group" aria-hidden={copy === 0 ? undefined : 'true'}>
							{tiles.map((category) => (
								<a
									class="home-cats__card"
									href={category.href}
									tabindex={copy === 0 ? undefined : -1}
								>
									<img src={category.image} alt="" draggable="false" decoding="async" />
									<span class="home-cats__label">{category.label}</span>
								</a>
							))}
						</div>
					))}
				</div>
			</div>
		</section>
	)
}

<script is:inline>
	(function () {
		if (window.__istockCatsMarqueeV2) return;
		window.__istockCatsMarqueeV2 = true;

		function setup(root) {
			if (root.getAttribute('data-cats-ready')) return;
			root.setAttribute('data-cats-ready', '1');

			var viewport = root.querySelector('[data-cats-scroller]');
			var track = root.querySelector('.home-cats__track');
			var groups = root.querySelectorAll('.home-cats__group');
			if (!viewport || !track || groups.length < 2) return;

			var duration = parseFloat(root.getAttribute('data-cats-duration')) || 48;
			var offset = 0;
			var loop = 0;
			var dragging = false;
			var axis = '';
			var moved = 0;
			var pointerId = null;
			var startX = 0;
			var startY = 0;
			var startOffset = 0;
			var userUntil = 0;
			var lastTs = 0;
			var IDLE_MS = 2500;

			function measure() {
				var w = Math.round(groups[1].offsetLeft - groups[0].offsetLeft);
				if (w < 8) w = Math.round(groups[0].offsetWidth);
				loop = w;
				return w;
			}

			function wrap(value) {
				if (loop < 8) measure();
				if (loop < 8) return value;
				value %= loop;
				if (value > 0) value -= loop;
				if (value <= -loop) value += loop;
				return value;
			}

			function apply() {
				offset = wrap(offset);
				track.style.transform = 'translate3d(' + offset + 'px,0,0)';
			}

			function holding() {
				return dragging || Date.now() < userUntil;
			}

			function tick(ts) {
				if (!lastTs) lastTs = ts;
				var dt = Math.min(0.05, (ts - lastTs) / 1000);
				lastTs = ts;
				if (!holding() && loop > 8) {
					offset -= (loop / duration) * dt;
					apply();
				}
				requestAnimationFrame(tick);
			}

			function onDown(event) {
				if (event.button != null && event.button !== 0) return;
				dragging = true;
				axis = '';
				moved = 0;
				pointerId = event.pointerId;
				startX = event.clientX;
				startY = event.clientY;
				measure();
				startOffset = offset;
				userUntil = Number.POSITIVE_INFINITY;
				root.classList.add('is-grabbing');
				try {
					viewport.setPointerCapture(event.pointerId);
				} catch (err) {}
			}

			function onMove(event) {
				if (!dragging || (pointerId != null && event.pointerId !== pointerId)) return;
				var dx = event.clientX - startX;
				var dy = event.clientY - startY;
				moved = Math.max(moved, Math.abs(dx), Math.abs(dy));
				if (!axis && moved > 8) axis = Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y';
				if (axis !== 'x') return;
				if (event.cancelable) event.preventDefault();
				root.classList.add('is-dragging');
				offset = startOffset + dx;
				apply();
			}

			function onUp(event) {
				if (!dragging) return;
				if (pointerId != null && event && event.pointerId !== pointerId) return;
				dragging = false;
				pointerId = null;
				root.classList.remove('is-grabbing');
				window.setTimeout(function () {
					root.classList.remove('is-dragging');
				}, 80);
				userUntil = Date.now() + IDLE_MS;
				apply();
			}

			viewport.addEventListener('pointerdown', onDown);
			viewport.addEventListener('pointermove', onMove, { passive: false });
			viewport.addEventListener('pointerup', onUp);
			viewport.addEventListener('pointercancel', onUp);
			viewport.addEventListener(
				'touchmove',
				function (event) {
					if (axis === 'x' && event.cancelable) event.preventDefault();
				},
				{ passive: false }
			);
			viewport.addEventListener(
				'click',
				function (event) {
					if (moved < 8) return;
					event.preventDefault();
					event.stopPropagation();
				},
				true
			);
			viewport.addEventListener('dragstart', function (event) {
				event.preventDefault();
			});

			function ready() {
				measure();
				apply();
				requestAnimationFrame(tick);
			}

			var imgs = track.querySelectorAll('img');
			var pending = 0;
			function one() {
				pending -= 1;
				if (pending <= 0) ready();
			}
			for (var i = 0; i < imgs.length; i += 1) {
				if (imgs[i].complete) continue;
				pending += 1;
				imgs[i].addEventListener('load', one);
				imgs[i].addEventListener('error', one);
			}
			if (pending === 0) ready();
			window.addEventListener('resize', function () {
				measure();
				apply();
			});
		}

		function boot() {
			document.querySelectorAll('.home-cats').forEach(setup);
		}
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
	})();
</script>
