---
type Tile = {
	href: string;
	image: string;
	label: string;
};

type Props = {
	tiles: Tile[];
	label: string;
};

const { tiles, label } = Astro.props;
const duration = Math.max(48, tiles.length * 3.2);
---

{
	tiles.length > 0 && (
		<section class="home-bleed home-cats" aria-label={label}>
			<div class="home-cats__viewport">
				<div class="home-cats__track" style={`--home-cats-duration: ${duration}s`}>
					<div class="home-cats__group">
						{tiles.map((category) => (
							<a class="home-cats__card" href={category.href}>
								<img src={category.image} alt="" draggable="false" decoding="async" />
								<span class="home-cats__label">{category.label}</span>
							</a>
						))}
					</div>
					<div class="home-cats__group" aria-hidden="true">
						{tiles.map((category) => (
							<a class="home-cats__card" href={category.href} tabindex={-1}>
								<img src={category.image} alt="" draggable="false" decoding="async" />
								<span class="home-cats__label">{category.label}</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	)
}

<script is:inline>
	(function () {
		function boot() {
			var roots = document.querySelectorAll('.home-cats:not([data-cats-drag])');
			for (var i = 0; i < roots.length; i += 1) bind(roots[i]);
		}

		function bind(root) {
			root.setAttribute('data-cats-drag', '1');
			var viewport = root.querySelector('.home-cats__viewport');
			var track = root.querySelector('.home-cats__track');
			var group = track && track.querySelector('.home-cats__group');
			if (!viewport || !track || !group) return;

			var offset = 0;
			var loopW = 0;
			var dragging = false;
			var captured = false;
			var pointerId = null;
			var startX = 0;
			var startY = 0;
			var startOffset = 0;
			var moved = 0;
			var axis = '';
			var anim = null;
			var durationMs =
				(parseFloat(getComputedStyle(track).getPropertyValue('--home-cats-duration')) || 48) * 1000;

			function measure() {
				loopW = Math.round(group.scrollWidth || group.offsetWidth || 0);
				return loopW;
			}

			function wrap(value) {
				if (loopW <= 0) measure();
				if (loopW <= 0) return value;
				value %= loopW;
				if (value > 0) value -= loopW;
				return value;
			}

			function readTx() {
				var t = getComputedStyle(track).transform;
				if (!t || t === 'none') return 0;
				try {
					return new DOMMatrix(t).m41;
				} catch (err) {
					var parts = t.match(/-?\d+\.?\d*/g);
					return parts && parts.length >= 6 ? parseFloat(parts[4]) : 0;
				}
			}

			function stopAnim() {
				if (anim) {
					try {
						anim.cancel();
					} catch (err) {}
					anim = null;
				}
				if (typeof track.getAnimations === 'function') {
					track.getAnimations().forEach(function (item) {
						try {
							item.cancel();
						} catch (err) {}
					});
				}
				track.style.animation = 'none';
			}

			function apply(value) {
				offset = wrap(value);
				track.style.transform = 'translate3d(' + offset + 'px,0,0)';
			}

			function play() {
				measure();
				if (loopW <= 0) return;
				offset = wrap(offset);
				root.classList.add('is-manual');
				stopAnim();
				track.style.transform = 'translate3d(' + offset + 'px,0,0)';
				if (typeof track.animate !== 'function') return;
				anim = track.animate(
					[
						{ transform: 'translate3d(' + offset + 'px,0,0)' },
						{ transform: 'translate3d(' + (offset - loopW) + 'px,0,0)' },
					],
					{ duration: durationMs, iterations: Infinity, easing: 'linear' }
				);
			}

			function takeOver() {
				measure();
				offset = wrap(readTx());
				root.classList.add('is-manual');
				stopAnim();
				apply(offset);
			}

			viewport.addEventListener('pointerdown', function (event) {
				if (event.button !== 0) return;
				dragging = true;
				captured = false;
				axis = '';
				moved = 0;
				pointerId = event.pointerId;
				startX = event.clientX;
				startY = event.clientY;
				takeOver();
				startOffset = offset;
				root.classList.add('is-grabbing');
				root.classList.remove('is-dragging');
			});

			viewport.addEventListener('pointermove', function (event) {
				if (!dragging || event.pointerId !== pointerId) return;
				var dx = event.clientX - startX;
				var dy = event.clientY - startY;
				moved = Math.max(moved, Math.abs(dx), Math.abs(dy));
				if (!axis && moved > 8) {
					axis = Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y';
				}
				if (axis !== 'x') return;
				if (!captured) {
					captured = true;
					root.classList.add('is-dragging');
					try {
						viewport.setPointerCapture(event.pointerId);
					} catch (err) {}
				}
				if (event.cancelable) event.preventDefault();
				apply(startOffset + dx);
			});

			function endDrag(event) {
				if (!dragging) return;
				if (event && pointerId != null && event.pointerId !== pointerId) return;
				var didDrag = captured;
				dragging = false;
				captured = false;
				pointerId = null;
				axis = '';
				root.classList.remove('is-grabbing');
				if (didDrag) {
					root.classList.add('is-dragging');
					window.setTimeout(function () {
						root.classList.remove('is-dragging');
					}, 80);
				} else {
					root.classList.remove('is-dragging');
				}
				play();
			}

			window.addEventListener('pointerup', endDrag);
			window.addEventListener('pointercancel', endDrag);
			viewport.addEventListener(
				'click',
				function (event) {
					if (!root.classList.contains('is-dragging')) return;
					event.preventDefault();
					event.stopPropagation();
				},
				true
			);
			track.addEventListener('dragstart', function (event) {
				event.preventDefault();
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
	})();
</script>
