---
import { CATEGORIES } from '../config/categories';
import { fromPathSlug } from '../lib/paths';

interface Props {
	variant?: 'hero' | 'bar';
	placeholder?: string;
}

const {
	variant = 'hero',
	placeholder = 'Try “coastal light”, “geometry”, or a color mood…',
} = Astro.props;

const path = Astro.url.pathname;
const pathQuery =
	path.startsWith('/s/') && path.length > 3
		? fromPathSlug(decodeURIComponent(path.slice(3).split('/')[0] || ''))
		: '';
const q = pathQuery || Astro.url.searchParams.get('q') || '';
const pathType = CATEGORIES.find((category) => path === `/${category.slug}`)?.slug;
const selected = Astro.url.searchParams.get('category') ?? pathType ?? 'all';
const pathTopic =
	path.startsWith('/c/') && path.length > 3 ? decodeURIComponent(path.slice(3).split('/')[0] || '') : '';
const topic = Astro.url.searchParams.get('topic') || pathTopic;
const color = Astro.url.searchParams.get('color') || '';
const orient = Astro.url.searchParams.get('orient') || '';
const exclude = Astro.url.searchParams.get('exclude') || '';
const sort = Astro.url.searchParams.get('sort') || '';

const options = [
	{ value: 'all', label: 'All media' },
	...CATEGORIES.map((category) => ({ value: category.slug, label: category.label })),
];

const selectedLabel = options.find((option) => option.value === selected)?.label ?? 'All media';
---

<form class:list={['search-bar', `search-bar--${variant}`]} action="/s/" method="get" role="search">
	<input type="hidden" name="category" value={selected} data-category-input />
	{topic ? <input type="hidden" name="topic" value={topic} /> : null}
	{color ? <input type="hidden" name="color" value={color} /> : null}
	{orient ? <input type="hidden" name="orient" value={orient} /> : null}
	{exclude ? <input type="hidden" name="exclude" value={exclude} /> : null}
	{sort ? <input type="hidden" name="sort" value={sort} /> : null}

	<div class="search-bar__filter" data-category-dropdown>
		<button
			class="search-bar__filter-trigger"
			type="button"
			aria-haspopup="listbox"
			aria-expanded="false"
			data-category-trigger
		>
			<span class="search-bar__filter-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" width="18" height="18">
					<rect x="3" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
					<rect x="14" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
					<rect x="3" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
					<rect x="14" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
				</svg>
			</span>
			<span data-category-label>{selectedLabel}</span>
			<span class="search-bar__chevron" aria-hidden="true">▾</span>
		</button>

		<ul class="search-bar__menu" role="listbox" hidden data-category-menu>
			{
				options.map((option) => (
					<li role="option" aria-selected={option.value === selected ? 'true' : 'false'}>
						<button type="button" data-category-option={option.value}>
							{option.label}
						</button>
					</li>
				))
			}
		</ul>
	</div>

	<input
		class="search-bar__input"
		type="search"
		name="q"
		value={q}
		placeholder={placeholder}
		autocomplete="off"
	/>

	<button class="search-bar__visual" type="button" aria-label="Search by image" data-upload-open>
		<span class="search-bar__visual-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" width="22" height="22">
				<defs>
					<mask id={`search-visual-mask-${variant}`}>
						<rect width="24" height="24" fill="white"></rect>
						<circle cx="18.15" cy="5.85" r="4.35" fill="black"></circle>
					</mask>
				</defs>
				<g mask={`url(#search-visual-mask-${variant})`}>
					<rect
						x="2.55"
						y="5.35"
						width="15.7"
						height="13.4"
						rx="2.05"
						stroke="currentColor"
						stroke-width="1.55"></rect>
					<path
						d="M4.15 17.45 8.35 12.7l2.2 2.25 3.05-3.75 5.05 6.25"
						stroke="currentColor"
						stroke-width="1.55"
						stroke-linejoin="round"></path>
					<circle cx="7.15" cy="9.15" r="1.15" fill="currentColor"></circle>
				</g>
				<circle cx="18.15" cy="5.85" r="3.35" stroke="currentColor" stroke-width="1.55"></circle>
				<path
					d="M18.15 4.4v2.9M16.7 5.85h2.9"
					stroke="currentColor"
					stroke-width="1.55"
					stroke-linecap="round"></path>
			</svg>
		</span>
		<span class="search-bar__visual-tip" role="tooltip">SEARCH BY IMAGE</span>
	</button>

	<button class="search-bar__submit" type="submit" aria-label="Search">
		<svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
			<circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
			<path d="M16.2 16.2 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
		</svg>
	</button>
</form>

<script is:inline>
	(function () {
		if (window.__istockSearchUiBound) return;
		window.__istockSearchUiBound = true;

		function closeAllMenus() {
			document.querySelectorAll('[data-category-dropdown]').forEach(function (root) {
				var menu = root.querySelector('[data-category-menu]');
				var trigger = root.querySelector('[data-category-trigger]');
				if (menu) menu.hidden = true;
				if (trigger) trigger.setAttribute('aria-expanded', 'false');
			});
		}

		function getModal() {
			return document.querySelector('[data-upload-modal]');
		}

		function openModal() {
			var modal = getModal();
			if (!modal) return;
			modal.hidden = false;
			document.body.classList.add('upload-modal-open');
			var status = modal.querySelector('[data-upload-status]');
			if (status) {
				status.hidden = true;
				status.textContent = '';
			}
		}

		function closeModal() {
			var modal = getModal();
			if (!modal) return;
			modal.hidden = true;
			document.body.classList.remove('upload-modal-open');
			var drop = modal.querySelector('[data-upload-drop]');
			if (drop) drop.classList.remove('is-dragover', 'is-uploading');
		}

		async function extractQuery(file) {
			return new Promise(function (resolve, reject) {
				var url = URL.createObjectURL(file);
				var img = new Image();
				img.onload = function () {
					var canvas = document.createElement('canvas');
					var sample = 48;
					var thumbSize = 160;
					canvas.width = sample;
					canvas.height = sample;
					var ctx = canvas.getContext('2d');
					if (!ctx) {
						URL.revokeObjectURL(url);
						reject(new Error('Canvas unavailable'));
						return;
					}
					ctx.drawImage(img, 0, 0, sample, sample);
					var data = ctx.getImageData(0, 0, sample, sample).data;
					var buckets = {};
					for (var i = 0; i < data.length; i += 4) {
						if (data[i + 3] < 128) continue;
						var r = data[i] & 240;
						var g = data[i + 1] & 240;
						var b = data[i + 2] & 240;
						var key = r + ',' + g + ',' + b;
						buckets[key] = (buckets[key] || 0) + 1;
					}
					var hexes = Object.keys(buckets)
						.sort(function (a, b) {
							return buckets[b] - buckets[a];
						})
						.slice(0, 5)
						.map(function (k) {
							return k
								.split(',')
								.map(function (n) {
									return Number(n).toString(16).padStart(2, '0');
								})
								.join('');
						});
					canvas.width = thumbSize;
					canvas.height = thumbSize;
					ctx.drawImage(img, 0, 0, thumbSize, thumbSize);
					var thumb = canvas.toDataURL('image/jpeg', 0.72);
					URL.revokeObjectURL(url);
					resolve({ hexes: hexes, thumb: thumb });
				};
				img.onerror = function () {
					URL.revokeObjectURL(url);
					reject(new Error('Could not read that image'));
				};
				img.src = url;
			});
		}

		async function uploadFile(file) {
			var modal = getModal();
			var status = modal && modal.querySelector('[data-upload-status]');
			var choose = modal && modal.querySelector('[data-upload-choose]');
			var drop = modal && modal.querySelector('[data-upload-drop]');

			var allowed =
				/^image\/(jpeg|png|webp|gif)$/.test(file.type) ||
				/\.(jpe?g|png|webp|gif)$/i.test(file.name);

			if (!allowed) {
				alert('Accepted formats: JPG, PNG, WebP, GIF');
				return;
			}

			if (file.size > 8 * 1024 * 1024) {
				alert('Image must be 8 MB or smaller.');
				return;
			}

			if (status) {
				status.hidden = false;
				status.textContent = 'Preparing “' + file.name + '”…';
			}
			if (choose) choose.disabled = true;
			if (drop) drop.classList.add('is-uploading');

			try {
				var query = await extractQuery(file);
				try {
					sessionStorage.setItem(
						'istockvisual-visual-search',
						JSON.stringify({
							name: file.name,
							thumb: query.thumb,
							colors: query.hexes,
						}),
					);
				} catch (err) {
					/* quota / private mode */
				}

				var params = new URLSearchParams({
					mode: 'visual',
					name: file.name,
					c: query.hexes.join(','),
				});

				try {
					var body = new FormData();
					body.append('file', file);
					var res = await fetch('/api/upload/visual-search', {
						method: 'POST',
						body: body,
					});
					var data = await res.json();
					if (res.ok && data && data.key) {
						params.set('key', data.key);
					}
				} catch (err) {
					/* matching still works from colors read in this browser */
				}

				window.location.href = '/s/?' + params.toString();
			} catch (err) {
				if (status) {
					status.hidden = false;
					status.textContent = err instanceof Error ? err.message : 'Could not read that image';
				} else {
					alert(err instanceof Error ? err.message : 'Could not read that image');
				}
				if (choose) choose.disabled = false;
				if (drop) drop.classList.remove('is-uploading');
			}
		}

		document.addEventListener('submit', function (event) {
			var form = event.target;
			if (!(form instanceof HTMLFormElement) || !form.classList.contains('search-bar')) return;
			event.preventDefault();
			var input = form.querySelector('.search-bar__input');
			var hidden = form.querySelector('[data-category-input]');
			var raw = ((input && input.value) || '').trim().toLowerCase();
			var slug = raw
				.replace(/[^\p{L}\p{N}]+/gu, '-')
				.replace(/^-+|-+$/g, '')
				.slice(0, 96);
			var cat = (hidden && hidden.value) || 'all';
			var url = slug ? '/s/' + encodeURIComponent(slug) : '/s/';
			if (cat && cat !== 'all') url += '?category=' + encodeURIComponent(cat);
			window.location.href = url;
		});

		document.addEventListener('click', function (event) {
			var target = event.target;
			if (!(target instanceof Element)) return;

			var optionBtn = target.closest('[data-category-option]');
			if (optionBtn) {
				event.preventDefault();
				event.stopPropagation();
				var root = optionBtn.closest('[data-category-dropdown]');
				var form = optionBtn.closest('form');
				if (!root || !form) return;
				var hidden = form.querySelector('[data-category-input]');
				var label = root.querySelector('[data-category-label]');
				var menu = root.querySelector('[data-category-menu]');
				var trigger = root.querySelector('[data-category-trigger]');
				var value = optionBtn.getAttribute('data-category-option') || 'all';
				if (hidden) hidden.value = value;
				if (label) label.textContent = (optionBtn.textContent || 'All media').trim();
				if (menu) {
					menu.querySelectorAll('[role="option"]').forEach(function (item) {
						var btn = item.querySelector('[data-category-option]');
						item.setAttribute(
							'aria-selected',
							btn && btn.getAttribute('data-category-option') === value ? 'true' : 'false',
						);
					});
					menu.hidden = true;
				}
				if (trigger) trigger.setAttribute('aria-expanded', 'false');
				return;
			}

			var triggerBtn = target.closest('[data-category-trigger]');
			if (triggerBtn) {
				event.preventDefault();
				event.stopPropagation();
				var dropdown = triggerBtn.closest('[data-category-dropdown]');
				var dropdownMenu = dropdown && dropdown.querySelector('[data-category-menu]');
				if (!dropdown || !dropdownMenu) return;
				var willOpen = dropdownMenu.hidden;
				closeAllMenus();
				if (willOpen) {
					dropdownMenu.hidden = false;
					triggerBtn.setAttribute('aria-expanded', 'true');
				}
				return;
			}

			if (target.closest('[data-upload-open]')) {
				event.preventDefault();
				event.stopPropagation();
				closeAllMenus();
				openModal();
				return;
			}

			if (target.closest('[data-upload-close]')) {
				event.preventDefault();
				closeModal();
				return;
			}

			if (target.closest('[data-upload-choose]')) {
				event.preventDefault();
				var input = document.querySelector('[data-upload-input]');
				if (input) input.click();
				return;
			}

			closeAllMenus();
		});

		document.addEventListener('change', function (event) {
			var target = event.target;
			if (!(target instanceof HTMLInputElement) || !target.matches('[data-upload-input]')) return;
			var file = target.files && target.files[0];
			if (!file) return;
			uploadFile(file);
			target.value = '';
		});

		document.addEventListener('dragover', function (event) {
			var drop = event.target instanceof Element && event.target.closest('[data-upload-drop]');
			var modal = getModal();
			if (!modal || modal.hidden || !drop) return;
			event.preventDefault();
			drop.classList.add('is-dragover');
		});

		document.addEventListener('dragleave', function (event) {
			var drop = event.target instanceof Element && event.target.closest('[data-upload-drop]');
			if (!drop) return;
			drop.classList.remove('is-dragover');
		});

		document.addEventListener('drop', function (event) {
			var drop = event.target instanceof Element && event.target.closest('[data-upload-drop]');
			var modal = getModal();
			if (!modal || modal.hidden || !drop) return;
			event.preventDefault();
			drop.classList.remove('is-dragover');
			var file = event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0];
			if (file) uploadFile(file);
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') {
				closeAllMenus();
				closeModal();
			}
		});

		var visualTipBtn = null;

		function placeVisualTip(btn) {
			var tip = btn.querySelector('.search-bar__visual-tip');
			if (!(tip instanceof HTMLElement)) return;
			var pad = 10;
			tip.classList.remove('is-above');
			tip.style.left = '50%';
			tip.style.right = 'auto';
			tip.style.top = '';
			tip.style.bottom = '';
			tip.style.transform = 'translateX(-50%)';
			tip.style.setProperty('--tip-arrow', '50%');

			var rect = tip.getBoundingClientRect();
			if (!rect.width) return;

			var shift = 0;
			if (rect.left < pad) shift += pad - rect.left;
			if (rect.right + shift > window.innerWidth - pad) {
				shift -= rect.right + shift - (window.innerWidth - pad);
			}
			if (shift) {
				tip.style.transform = 'translateX(calc(-50% + ' + shift + 'px))';
				var arrow = rect.width / 2 - shift;
				tip.style.setProperty('--tip-arrow', Math.max(10, Math.min(rect.width - 10, arrow)) + 'px');
			}

			var btnRect = btn.getBoundingClientRect();
			if (window.innerHeight - btnRect.bottom < rect.height + 16 && btnRect.top > rect.height + 16) {
				tip.classList.add('is-above');
			}
		}

		function hideVisualTip() {
			if (!visualTipBtn) return;
			var tip = visualTipBtn.querySelector('.search-bar__visual-tip');
			visualTipBtn.classList.remove('is-tip-open');
			if (tip instanceof HTMLElement) {
				tip.classList.remove('is-above');
				tip.style.left = '';
				tip.style.right = '';
				tip.style.top = '';
				tip.style.bottom = '';
				tip.style.transform = '';
				tip.style.removeProperty('--tip-arrow');
			}
			visualTipBtn = null;
		}

		function showVisualTip(btn) {
			if (btn.classList.contains('is-uploading') || btn.disabled) return;
			if (visualTipBtn && visualTipBtn !== btn) hideVisualTip();
			visualTipBtn = btn;
			placeVisualTip(btn);
			btn.classList.add('is-tip-open');
		}

		document.addEventListener('pointerover', function (event) {
			var btn = event.target instanceof Element && event.target.closest('.search-bar__visual');
			if (!btn || visualTipBtn === btn) return;
			showVisualTip(btn);
		});

		document.addEventListener('pointerout', function (event) {
			if (!visualTipBtn) return;
			var related = event.relatedTarget;
			if (related instanceof Node && visualTipBtn.contains(related)) return;
			var btn = event.target instanceof Element && event.target.closest('.search-bar__visual');
			if (btn !== visualTipBtn) return;
			hideVisualTip();
		});

		document.addEventListener('focusin', function (event) {
			var btn = event.target instanceof Element && event.target.closest('.search-bar__visual');
			if (btn) showVisualTip(btn);
		});

		document.addEventListener('focusout', function (event) {
			if (!visualTipBtn) return;
			var related = event.relatedTarget;
			if (related instanceof Node && visualTipBtn.contains(related)) return;
			hideVisualTip();
		});

		window.addEventListener('resize', function () {
			if (visualTipBtn) placeVisualTip(visualTipBtn);
		});

		window.addEventListener(
			'scroll',
			function () {
				if (visualTipBtn) placeVisualTip(visualTipBtn);
			},
			true,
		);
	})();
</script>
