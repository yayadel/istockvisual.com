---
import { CATEGORIES } from '../config/categories';

interface Props {
	variant?: 'hero' | 'bar';
	placeholder?: string;
}

const {
	variant = 'hero',
	placeholder = 'Search millions of images free of AI-generated content',
} = Astro.props;

const q = Astro.url.searchParams.get('q') ?? '';
const selected = Astro.url.searchParams.get('category') ?? 'all';
---

<form class:list={['search-bar', `search-bar--${variant}`]} action="/search" method="get" role="search">
	<label class="search-bar__filter">
		<span class="search-bar__filter-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" width="18" height="18">
				<rect x="3" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
				<rect x="14" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6"></rect>
			</svg>
		</span>
		<select name="category" aria-label="Content type">
			<option value="all" selected={selected === 'all'}>All content</option>
			{
				CATEGORIES.map((category) => (
					<option value={category.slug} selected={selected === category.slug}>
						{category.label}
					</option>
				))
			}
		</select>
		<span class="search-bar__chevron" aria-hidden="true">▾</span>
	</label>

	<input
		class="search-bar__input"
		type="search"
		name="q"
		value={q}
		placeholder={placeholder}
		autocomplete="off"
	/>

	<button class="search-bar__visual" type="button" title="Search by image (coming soon)" disabled>
		<span class="search-bar__visual-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" width="18" height="18">
				<path
					d="M4 7.5A2.5 2.5 0 0 1 6.5 5h2.1l1.1-1.4A1.5 1.5 0 0 1 10.9 3h2.2a1.5 1.5 0 0 1 1.2.6L15.4 5h2.1A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Z"
					stroke="currentColor"
					stroke-width="1.6"></path>
				<path d="M12 9v5M9.5 11.5 12 9l2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
		<span class="search-bar__visual-text">Search by image</span>
	</button>

	<button class="search-bar__submit" type="submit" aria-label="Search">
		<svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
			<circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
			<path d="M16.2 16.2 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
		</svg>
	</button>
</form>
