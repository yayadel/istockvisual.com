---
interface Props {
	name:
		| 'pro'
		| 'res'
		| 'format'
		| 'license'
		| 'refund'
		| 'image'
		| 'convert'
		| 'vectorize'
		| 'social'
		| 'watermark'
		| 'palette'
		| 'search';
}

const { name } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.65"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'pro' && (
			<>
				<path d="M5 16.5 7.4 8.2 12 12.4 16.6 8.2 19 16.5H5Z"></path>
				<path d="M6.2 19.2h11.6"></path>
			</>
		)
	}
	{
		name === 'res' && (
			<>
				<rect x="3.5" y="5.5" width="17" height="13" rx="1.4"></rect>
				<path d="M7.2 15.2h3.2M14.2 15.2h2.6"></path>
			</>
		)
	}
	{
		name === 'format' && (
			<>
				<path d="M7 5.5h7.2L18.5 10v8.5H7z"></path>
				<path d="M14.2 5.5V10H18.5"></path>
				<path d="M9.4 13.4h5.4M9.4 16.2h3.6"></path>
			</>
		)
	}
	{
		name === 'license' && (
			<>
				<rect x="5" y="4" width="14" height="16" rx="1.4"></rect>
				<path d="M8.2 8.4h7.6M8.2 12h7.6M8.2 15.6h4.4"></path>
			</>
		)
	}
	{
		name === 'refund' && (
			<>
				<circle cx="12" cy="12" r="7.4"></circle>
				<path d="M12 8.2v4.2l2.6 1.6"></path>
			</>
		)
	}
	{
		name === 'image' && (
			<>
				<rect x="3.5" y="5" width="17" height="14" rx="1.6"></rect>
				<path d="M3.8 16.2 8.4 11.6l3.2 3.2 3.1-3.1 5.5 5.5"></path>
				<circle cx="9" cy="9.8" r="1.25" fill="currentColor" stroke="none"></circle>
			</>
		)
	}
	{
		name === 'convert' && (
			<>
				<rect x="4" y="4.5" width="7.2" height="6.4" rx="1"></rect>
				<rect x="12.8" y="13.1" width="7.2" height="6.4" rx="1"></rect>
				<path d="M15.2 7.7h2.4v2.4M8.8 16.3H6.4v-2.4"></path>
				<path d="M16.4 7.7 8.8 16.3"></path>
			</>
		)
	}
	{
		name === 'vectorize' && (
			<>
				<path d="M5 17.5 12 5.8 19 17.5Z"></path>
				<circle cx="12" cy="5.8" r="1.15" fill="currentColor" stroke="none"></circle>
				<circle cx="5" cy="17.5" r="1.15" fill="currentColor" stroke="none"></circle>
				<circle cx="19" cy="17.5" r="1.15" fill="currentColor" stroke="none"></circle>
			</>
		)
	}
	{
		name === 'social' && (
			<>
				<rect x="4" y="6.5" width="7" height="11" rx="1.3"></rect>
				<rect x="13" y="4.5" width="7" height="7.5" rx="1.3"></rect>
			</>
		)
	}
	{
		name === 'watermark' && (
			<>
				<rect x="4" y="5" width="16" height="14" rx="1.5"></rect>
				<path d="M8 15.2 12 9.4l4 5.8"></path>
				<path d="M7.4 9.2h.01"></path>
			</>
		)
	}
	{
		name === 'palette' && (
			<>
				<path d="M12 3.5c-4.7 0-8.5 3.7-8.5 8.4 0 3.5 2.8 6.6 6.6 6.6.7 0 1.3-.6 1.3-1.3 0-.3-.1-.6-.3-.9-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.6c2.6 0 4.8-1.9 4.8-4.6 0-3.1-3.5-4.9-8-4.9Z"></path>
				<circle cx="8.2" cy="10.6" r="0.85" fill="currentColor" stroke="none"></circle>
				<circle cx="11.1" cy="7.8" r="0.85" fill="currentColor" stroke="none"></circle>
				<circle cx="15" cy="8.1" r="0.85" fill="currentColor" stroke="none"></circle>
			</>
		)
	}
	{
		name === 'search' && (
			<>
				<circle cx="11" cy="11" r="6.4"></circle>
				<path d="M15.7 15.7 20 20"></path>
			</>
		)
	}
</svg>
