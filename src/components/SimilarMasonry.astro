---
import type { AssetDetail } from '../lib/asset-types';
import AssetCard from './AssetCard.astro';

interface Props {
	assets: AssetDetail[];
	viewAllHref: string;
	viewAllLabel: string;
}

const { assets, viewAllHref, viewAllLabel } = Astro.props;
---

{
	assets.length > 0 && (
		<section class="similar">
			<div class="similar__inner">
				<div class="similar__head">
					<h2>Similar images</h2>
					<a href={viewAllHref}>
						{viewAllLabel} <span aria-hidden="true">›</span>
					</a>
				</div>
				<div class="asset-grid">
					{assets.map((asset, index) => (
						<AssetCard asset={asset} index={index} />
					))}
				</div>
			</div>
		</section>
	)
}
