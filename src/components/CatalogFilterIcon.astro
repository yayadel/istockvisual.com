---
interface Props {
	name: 'category' | 'type' | 'orient' | 'color' | 'exclude' | 'sort';
}

const { name } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.65"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'category' && (
			<>
				<rect x="4" y="4" width="7" height="7" rx="1.2"></rect>
				<rect x="13" y="4" width="7" height="7" rx="1.2"></rect>
				<rect x="4" y="13" width="7" height="7" rx="1.2"></rect>
				<rect x="13" y="13" width="7" height="7" rx="1.2"></rect>
			</>
		)
	}
	{
		name === 'type' && (
			<>
				<rect x="3.5" y="5" width="17" height="14" rx="2"></rect>
				<path d="M3.8 16.2 8.4 11.6l3.2 3.2 3.1-3.1 5.5 5.5"></path>
				<circle cx="9" cy="9.8" r="1.25" fill="currentColor" stroke="none"></circle>
			</>
		)
	}
	{
		name === 'orient' && (
			<>
				<rect x="3.5" y="8" width="11" height="8.5" rx="1.2"></rect>
				<rect x="11.5" y="4.5" width="9" height="12.5" rx="1.2"></rect>
			</>
		)
	}
	{
		name === 'color' && (
			<>
				<path d="M12 3.5c-4.7 0-8.5 3.7-8.5 8.4 0 3.5 2.8 6.6 6.6 6.6.7 0 1.3-.6 1.3-1.3 0-.3-.1-.6-.3-.9-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.6c2.6 0 4.8-1.9 4.8-4.6 0-3.1-3.5-4.9-8-4.9Z"></path>
				<circle cx="8.2" cy="10.6" r="0.85" fill="currentColor" stroke="none"></circle>
				<circle cx="11.1" cy="7.8" r="0.85" fill="currentColor" stroke="none"></circle>
				<circle cx="15" cy="8.1" r="0.85" fill="currentColor" stroke="none"></circle>
				<circle cx="16.8" cy="11.3" r="0.85" fill="currentColor" stroke="none"></circle>
			</>
		)
	}
	{
		name === 'exclude' && (
			<>
				<circle cx="11" cy="11" r="6.6"></circle>
				<path d="M15.8 15.8 20 20"></path>
				<path d="M8.2 11h5.6"></path>
			</>
		)
	}
	{
		name === 'sort' && (
			<>
				<path d="M8.2 8.2 12 4.5l3.8 3.7"></path>
				<path d="M12 5.2v6.2"></path>
				<path d="M8.2 15.8 12 19.5l3.8-3.7"></path>
				<path d="M12 18.8v-6.2"></path>
			</>
		)
	}
</svg>
