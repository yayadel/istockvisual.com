<section class="partner-strip" aria-label="Brand partners">
	<div class="partner-strip__inner">
		<p class="partner-strip__kicker">Brand partners</p>
		<ul class="partner-strip__logos">
			{
				partners.map((partner) => (
					<li>
						<span class="partner-strip__mark" title={partner.name} aria-label={partner.name}>
							<svg viewBox={`0 0 ${partner.w} 28`} width={partner.w} height="28" role="img">
								<title>{partner.name}</title>
								<path fill="currentColor" d={partner.path} />
							</svg>
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
