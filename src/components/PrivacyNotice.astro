---
import { COOKIES_PATH, PRIVACY_PATH } from '../lib/seo';
import {
	PRIVACY_NOTICE_COOKIE,
	PRIVACY_NOTICE_STORAGE_KEY,
	PRIVACY_NOTICE_TTL_SECONDS,
} from '../lib/privacy-notice';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const skip = path.startsWith('/admin') || path === PRIVACY_PATH;
---

{
	!skip && (
		<div
			class="privacy-notice"
			data-privacy-notice
			role="region"
			aria-label="Privacy notice"
		>
			<p>
				We use essential cookies to sign you in and keep the library running. Studio tools stay on
				your device.
				<a href={PRIVACY_PATH}>Privacy Policy</a>
				{' · '}
				<a href={COOKIES_PATH}>Cookies</a>
			</p>
			<button class="btn btn--primary" type="button" data-privacy-accept>
				Got it
			</button>
		</div>
	)
}

<script
	is:inline
	define:vars={{
		cookieName: PRIVACY_NOTICE_COOKIE,
		storageKey: PRIVACY_NOTICE_STORAGE_KEY,
		ttlSeconds: PRIVACY_NOTICE_TTL_SECONDS,
		enabled: !skip,
	}}
>
	(function () {
		if (!enabled) return;

		var root = document.querySelector('[data-privacy-notice]');
		var button = root && root.querySelector('[data-privacy-accept]');
		if (!root || !button) return;

		function stampComputer() {
			try {
				localStorage.setItem(storageKey, String(Date.now()));
			} catch (error) {}
			document.cookie = cookieName + '=1; Max-Age=' + ttlSeconds + '; Path=/; SameSite=Lax';
			document.documentElement.setAttribute('data-privacy-ok', '1');
		}

		function hideNotice() {
			stampComputer();
			root.setAttribute('hidden', '');
		}

		button.addEventListener('click', function () {
			hideNotice();
			fetch('/api/privacy-notice', { method: 'POST', credentials: 'same-origin' }).catch(function () {});
		});

		if (document.documentElement.getAttribute('data-privacy-ok') === '1') return;

		fetch('/api/privacy-notice', { credentials: 'same-origin' })
			.then(function (response) {
				return response.ok ? response.json() : { acknowledged: false };
			})
			.then(function (data) {
				if (data && data.acknowledged) hideNotice();
			})
			.catch(function () {});
	})();
</script>
