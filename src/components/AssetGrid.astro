---
import type { AssetDetail } from '../lib/asset-types';
import AssetCard from './AssetCard.astro';

interface Props {
	assets: AssetDetail[];
	emptyMessage?: string;
}

const TILES = ['short', 'landscape', 'square', 'portrait', 'landscape', 'square', 'short', 'landscape'] as const;
const TILE_RATIO: Record<(typeof TILES)[number], number> = {
	short: 9 / 16,
	landscape: 4 / 5,
	square: 1,
	portrait: 5 / 4,
};

const { assets, emptyMessage = 'No assets in this category yet.' } = Astro.props;

const columns = (() => {
	const count = 4;
	const cols: { asset: AssetDetail; index: number }[][] = Array.from({ length: count }, () => []);
	const heights = Array(count).fill(0);
	assets.forEach((asset, index) => {
		const slot = heights.indexOf(Math.min(...heights));
		cols[slot].push({ asset, index });
		heights[slot] += TILE_RATIO[TILES[index % TILES.length]];
	});
	return cols;
})();
---

{
	assets.length === 0 ? (
		<div class="empty">{emptyMessage}</div>
	) : (
		<div class="asset-grid" data-asset-grid>
			{columns.map((column) => (
				<div class="asset-grid__col">
					{column.map(({ asset, index }) => (
						<AssetCard asset={asset} index={index} />
					))}
				</div>
			))}
		</div>
	)
}

<script>
	const TILE_RATIO: Record<string, number> = {
		short: 9 / 16,
		landscape: 4 / 5,
		square: 1,
		portrait: 5 / 4,
		tall: 5 / 4,
	};

	const tileRatio = (card: HTMLElement) => {
		const match = card.className.match(/asset-card--(short|landscape|square|portrait|tall)/);
		return TILE_RATIO[match?.[1] || 'square'] || 1;
	};

	const columnCount = (width: number) => {
		if (width < 640) return 2;
		if (width < 900) return 3;
		return 4;
	};

	const revealImages = (grid: HTMLElement) => {
		grid.querySelectorAll('img').forEach((img) => {
			if (img.complete && img.naturalWidth) img.classList.add('is-ready');
		});
	};

	const applyCardSize = (card: HTMLElement, colWidth: number, width: number) => {
		const cap = width < 640 ? Math.min(window.innerHeight * 0.42, colWidth * 1.2) : colWidth * 1.25;
		const height = Math.min(colWidth * tileRatio(card), cap);
		card.style.flexGrow = '1';
		card.style.flexShrink = '1';
		card.style.flexBasis = `${height}px`;
		card.style.width = '100%';
		card.style.margin = '0';
		card.style.height = '';
	};

	const packGrid = (grid: HTMLElement) => {
		const width = Math.round(grid.clientWidth);
		if (width < 40) return;

		const count = columnCount(width);
		const gap = width < 640 ? 8 : 12;
		grid.style.gap = `${gap}px`;

		let cols = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .asset-grid__col'));
		const cards = Array.from(
			grid.querySelectorAll<HTMLElement>(':scope > .asset-card, :scope > .asset-grid__col > .asset-card'),
		);
		if (!cards.length) return;

		const colWidth = (width - gap * (count - 1)) / count;
		const sameWidth = grid.dataset.packWidth === String(width);
		if (sameWidth && cols.length === count) {
			cols.forEach((col) => {
				col.style.gap = `${gap}px`;
				col.querySelectorAll<HTMLElement>('.asset-card').forEach((card) => applyCardSize(card, colWidth, width));
			});
			return;
		}

		if (cols.length !== count) {
			cards.forEach((card) => grid.appendChild(card));
			cols.forEach((col) => col.remove());
			cols = Array.from({ length: count }, () => {
				const col = document.createElement('div');
				col.className = 'asset-grid__col';
				grid.appendChild(col);
				return col;
			});
			const heights = Array(count).fill(0);
			for (const card of cards) {
				const index = heights.indexOf(Math.min(...heights));
				cols[index].appendChild(card);
				heights[index] += colWidth * tileRatio(card) + gap;
			}
		}

		cols.forEach((col) => {
			col.style.gap = `${gap}px`;
			col.querySelectorAll<HTMLElement>('.asset-card').forEach((card) => applyCardSize(card, colWidth, width));
		});
		grid.dataset.packWidth = String(width);
		grid.classList.add('is-packed');
	};

	const watched = new WeakSet<HTMLElement>();

	const observe = () => {
		document.querySelectorAll<HTMLElement>('[data-asset-grid]').forEach((grid) => {
			grid.classList.add('is-enhanced');
			grid.addEventListener(
				'load',
				(event) => {
					if (event.target instanceof HTMLImageElement) event.target.classList.add('is-ready');
				},
				true,
			);
			revealImages(grid);
			if (!watched.has(grid)) {
				watched.add(grid);
				let lastWidth = Math.round(grid.clientWidth);
				new ResizeObserver((entries) => {
					const next = Math.round(entries[0]?.contentRect.width || grid.clientWidth);
					if (next === lastWidth) return;
					lastWidth = next;
					packGrid(grid);
				}).observe(grid);
			}
			packGrid(grid);
		});
	};

	observe();
	document.addEventListener('astro:page-load', observe);
</script>
