---
import FilerobotAssetEditor from './FilerobotAssetEditor';
import { publicImagePath } from '../lib/public-image';

interface Props {
	assetId: string;
	title: string;
	width?: number;
	height?: number;
	loggedIn?: boolean;
	isPro?: boolean;
}

const { assetId, title, width, height, loggedIn = false, isPro = false } = Astro.props;
const src500 = publicImagePath(assetId, '500');
const src1000 = publicImagePath(assetId, '1k');
---

<figure class="asset-preview" id="preview">
	<img
		class="asset-preview__poster"
		src={src1000}
		srcset={`${src500} 500w, ${src1000} 1000w`}
		sizes="(max-width: 900px) 100vw, 72vw"
		alt={title}
		width={width}
		height={height}
		fetchpriority="high"
		decoding="async"
	/>
	<noscript>
		<img
			class="asset-preview__image asset-preview__image--noscript"
			src={src500}
			alt={title}
			width={width}
			height={height}
			loading="eager"
			decoding="async"
		/>
	</noscript>
	<FilerobotAssetEditor
		client:only="react"
		imageUrl={src1000}
		title={title}
		width={width}
		height={height}
		loggedIn={loggedIn}
		isPro={isPro}
		assetId={assetId}
	/>
</figure>
