---
import FilerobotAssetEditor from './FilerobotAssetEditor';
import { publicImagePath } from '../lib/public-image';

interface Props {
	assetId: string;
	title: string;
	width?: number;
	height?: number;
	loggedIn?: boolean;
	isPro?: boolean;
}

const { assetId, title, width = 1536, height = 1024, loggedIn = false, isPro = false } = Astro.props;
const src500 = publicImagePath(assetId, '500');
const src1000 = publicImagePath(assetId, '1k');
const boardScale = Math.min(1, 1024 / Math.max(width, height, 1));
const boardWidth = Math.max(1, Math.round(width * boardScale));
const boardHeight = Math.min(860, Math.max(1, Math.round(height * boardScale)));
---

<script>
	import './preload-filerobot-editor.ts';
</script>

<figure
	class="asset-preview"
	id="preview"
	style={{
		'--preview-ar': `${width} / ${height}`,
		'--fie-img-w': String(boardWidth),
		'--fie-img-h': String(boardHeight),
	}}
>
	<div class="asset-preview__boot" aria-hidden="true">
		<div class="asset-preview__boot-sidebar">
			<span></span>
			<span></span>
			<span></span>
			<span></span>
			<span></span>
			<span></span>
			<span></span>
		</div>
		<div class="asset-preview__boot-main">
			<div class="asset-preview__boot-topbar"></div>
			<div class="asset-preview__boot-canvas"></div>
			<div class="asset-preview__boot-toolbar"></div>
		</div>
	</div>

	<FilerobotAssetEditor
		client:only="react"
		imageUrl={src1000}
		title={title}
		width={width}
		height={height}
		loggedIn={loggedIn}
		isPro={isPro}
		assetId={assetId}
	/>

	<img
		class="asset-preview__poster"
		src={src1000}
		srcset={`${src500} 500w, ${src1000} 1000w`}
		sizes="(max-width: 900px) 100vw, 72vw"
		alt={title}
		width={width}
		height={height}
		decoding="async"
		loading="eager"
	/>
	<noscript>
		<img
			class="asset-preview__image asset-preview__image--noscript"
			src={src500}
			alt={title}
			width={width}
			height={height}
			loading="eager"
			decoding="async"
		/>
	</noscript>
</figure>
