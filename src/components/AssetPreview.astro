---
import FilerobotAssetEditor from './FilerobotAssetEditor';
import { publicImagePath } from '../lib/public-image';

interface Props {
	assetId: string;
	title: string;
	width?: number;
	height?: number;
	loggedIn?: boolean;
	isPro?: boolean;
}

const { assetId, title, width, height, loggedIn = false, isPro = false } = Astro.props;
const src500 = publicImagePath(assetId, '500');
const src1000 = publicImagePath(assetId, '1k');
---

<figure class="asset-preview" id="preview">
	<noscript>
		<img
			class="asset-preview__image asset-preview__image--noscript"
			src={src500}
			alt={title}
			width={width}
			height={height}
			loading="eager"
			decoding="async"
		/>
	</noscript>
	<FilerobotAssetEditor
		client:only="react"
		imageUrl={src1000}
		title={title}
		width={width}
		height={height}
		loggedIn={loggedIn}
		isPro={isPro}
		assetId={assetId}
	>
		<div class="filerobot-studio__fallback">
			<img src={src1000} alt={title} width={width} height={height} />
			<p>Loading image editor…</p>
		</div>
	</FilerobotAssetEditor>
</figure>
