---
import type { AssetDetail } from '../lib/asset-types';

interface Props {
	asset: AssetDetail;
	index?: number;
}

const { asset } = Astro.props;
const href = `/${asset.category}/${asset.slug}`;
const width = Math.max(1, Number(asset.width) || 3);
const height = Math.max(1, Number(asset.height) || 2);
---

<a
	class="asset-card"
	href={href}
	data-w={width}
	data-h={height}
	style={`--w:${width};--h:${height};`}
>
	{
		asset.previewUrl ? (
			<img
				src={asset.previewUrl}
				alt={asset.title}
				width={width}
				height={height}
				loading="lazy"
			/>
		) : (
			<div class="asset-card__empty">No preview</div>
		)
	}
	{
		asset.isPremium && (
			<span class="asset-card__pro" aria-label="Pro">
				Pro
			</span>
		)
	}
	<span class="asset-card__caption">{asset.title}</span>
</a>
