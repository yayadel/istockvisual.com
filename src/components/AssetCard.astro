---
import type { AssetDetail } from '../lib/asset-types';
import { fitWidth } from '../lib/download-sizes';

interface Props {
	asset: AssetDetail;
	index?: number;
}

const TILES = ['portrait', 'short', 'square', 'landscape', 'tall', 'short', 'portrait', 'landscape'] as const;
const TILE_RATIO: Record<(typeof TILES)[number], number> = {
	short: 9 / 16,
	landscape: 4 / 5,
	square: 1,
	portrait: 5 / 4,
	tall: 5 / 3,
};

const { asset, index = 0 } = Astro.props;
const href = `/${asset.category}/${asset.slug}`;
const tile = TILES[index % TILES.length];
const ratio = TILE_RATIO[tile];
const preview = asset.previewUrl || '';
const src500 = preview
	? preview.includes('?')
		? `${preview}&size=500`
		: `${preview}?size=500`
	: '';
const box = fitWidth(asset.width || 1536, asset.height || 1024, 500);
---

<a class={`asset-card asset-card--${tile}`} href={href} data-ratio={ratio}>
	{
		src500 ? (
			<img
				src={src500}
				alt={asset.title}
				width={box.width}
				height={box.height}
				sizes="(max-width: 639px) 50vw, (max-width: 899px) 33vw, 25vw"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<div class="asset-card__empty">No preview</div>
		)
	}
	{
		asset.isPremium && (
			<span class="asset-card__pro" aria-label="Pro">
				Pro
			</span>
		)
	}
	<span class="asset-card__caption">{asset.title}</span>
</a>
