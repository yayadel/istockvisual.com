---
import type { AssetDetail } from '../lib/asset-types';

interface Props {
	asset: AssetDetail;
	index?: number;
}

/** Height-only variety. No column-span tiles, so the mosaic never leaves holes. */
const TILES = ['tall', 'landscape', 'square', 'short', 'portrait', 'tall', 'landscape', 'square'] as const;

const { asset, index = 0 } = Astro.props;
const href = `/${asset.category}/${asset.slug}`;
const tile = TILES[index % TILES.length];
---

<a class={`asset-card asset-card--${tile}`} href={href}>
	{
		asset.previewUrl ? (
			<img
				src={asset.previewUrl}
				alt={asset.title}
				width={asset.width}
				height={asset.height}
				loading="lazy"
			/>
		) : (
			<div class="asset-card__empty">No preview</div>
		)
	}
	{
		asset.isPremium && (
			<span class="asset-card__pro" aria-label="Pro">
				Pro
			</span>
		)
	}
	<span class="asset-card__caption">{asset.title}</span>
</a>
