---
import type { AssetDetail } from '../lib/asset-types';
import {
	CATALOG_SORTS,
	EMPTY_CATALOG_QUERY,
	catalogChips,
	catalogFacets,
	catalogHasFilters,
	catalogHeading,
	catalogHref,
	catalogPathAndParams,
	catalogRelatedKeywords,
	type CatalogQuery,
} from '../lib/catalog';
import { getContentCategoryBySlug, getContentCategoryIntro } from '../lib/content-categories';
import CatalogColorPicker from './CatalogColorPicker';
import CatalogFilterIcon from './CatalogFilterIcon.astro';
import AssetGrid from './AssetGrid.astro';

interface Props {
	assets: AssetDetail[];
	facetPool: AssetDetail[];
	query: CatalogQuery;
	emptyMessage?: string;
}

const { assets, facetPool, query, emptyMessage = 'No assets matched these filters.' } = Astro.props;
const facets = catalogFacets(facetPool, query);
const heading = catalogHeading(query);
const chips = catalogChips(query);
const related = query.q ? catalogRelatedKeywords(facetPool, query.q, 50) : [];
const intro = query.topic ? getContentCategoryIntro(query.topic) : null;
const topicLabel =
	facets.topics.find((item) => item.slug === query.topic)?.label ||
	getContentCategoryBySlug(query.topic)?.label ||
	'';
const clearHref = catalogHref({ ...EMPTY_CATALOG_QUERY, q: query.q });
const hasFilters = catalogHasFilters({ ...query, q: '' });
const excludeForm = catalogPathAndParams({ ...query, exclude: '' });
const colorForm = catalogPathAndParams({ ...query, color: '' });
---

<div class="catalog" data-catalog>
	<button class="catalog-filter-backdrop" type="button" hidden data-catalog-filter-backdrop aria-label="Close filters"></button>
	<aside class="catalog-filter" id="catalog-filter-panel" data-catalog-filter>
		<div class="catalog-filter__head">
			<p>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
					<path d="M4 7h16M7 12h10M10 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				Filters
			</p>
			<button class="catalog-filter__fold" type="button" data-catalog-collapse aria-label="Hide filters">
				<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
					<path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
			<button class="catalog-filter__close" type="button" data-catalog-filter-close aria-label="Close filters">
				<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
					<path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>

		<nav class="catalog-filter-rail" data-catalog-rail aria-label="Filter sections">
			<button
				class="catalog-filter-rail__btn catalog-filter-rail__btn--open"
				type="button"
				data-catalog-expand
				aria-label="Show filters"
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M6 3l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
				<span class="catalog-filter-rail__tip" aria-hidden="true">Show filters</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.topic && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="category"
				aria-label="Category"
			>
				<CatalogFilterIcon name="category" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Category</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.type !== 'all' && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="type"
				aria-label="Type"
			>
				<CatalogFilterIcon name="type" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Type</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.orient && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="orient"
				aria-label="Orientation"
			>
				<CatalogFilterIcon name="orient" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Orientation</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.color && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="color"
				aria-label="Color"
			>
				<CatalogFilterIcon name="color" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Color</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.exclude && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="exclude"
				aria-label="Exclude Keywords"
			>
				<CatalogFilterIcon name="exclude" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Exclude Keywords</span>
			</button>
			<button
				class:list={['catalog-filter-rail__btn', query.sort !== 'newest' && 'is-active']}
				type="button"
				data-catalog-expand
				data-filter-target="sort"
				aria-label="Sort By"
			>
				<CatalogFilterIcon name="sort" />
				<span class="catalog-filter-rail__tip" aria-hidden="true">Sort By</span>
			</button>
		</nav>

		<div class="catalog-filter__body">
			<details class:list={['catalog-acc', query.topic && 'has-pick']} data-filter-section="category">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="category" />
					</span>
					<span class="catalog-acc__label">{topicLabel || 'Category'}</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<a
						class:list={['catalog-filter__all', !query.topic && 'is-active']}
						href={catalogHref(query, { topic: '' })}
					>
						<span>All categories</span>
					</a>
					<ul class="catalog-filter__list catalog-filter__list--scroll">
						{
							facets.topics.map((item) => (
								<li>
									<a
										class:list={[query.topic === item.slug && 'is-active']}
										href={catalogHref(query, { topic: query.topic === item.slug ? '' : item.slug })}
										aria-current={query.topic === item.slug ? 'true' : undefined}
									>
										<span>{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</details>

			<details class="catalog-acc" open={query.type !== 'all' || undefined} data-filter-section="type">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="type" />
					</span>
					<span class="catalog-acc__label">Type</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<a
						class:list={['catalog-filter__all', query.type === 'all' && 'is-active']}
						href={catalogHref(query, { type: 'all' })}
					>
						<span>All types</span>
					</a>
					<ul class="catalog-filter__list">
						{
							facets.types
								.slice(1)
								.filter((item) => item.count > 0 || query.type === item.slug)
								.map((item) => (
								<li>
									<a
										class:list={[query.type === item.slug && 'is-active']}
										href={catalogHref(query, {
											type: query.type === item.slug ? 'all' : item.slug,
										})}
										aria-current={query.type === item.slug ? 'true' : undefined}
									>
										<span>{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</details>

			<details class="catalog-acc" open={Boolean(query.orient) || undefined} data-filter-section="orient">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="orient" />
					</span>
					<span class="catalog-acc__label">Orientation</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<ul class="catalog-filter__list">
						{
							facets.orients.map((item) => (
								<li>
									<a
										class:list={[query.orient === item.id && 'is-active']}
										href={catalogHref(query, { orient: query.orient === item.id ? '' : item.id })}
										aria-current={query.orient === item.id ? 'true' : undefined}
									>
										<span>{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</details>

			<details class="catalog-acc" open data-filter-section="color">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="color" />
					</span>
					<span class="catalog-acc__label">Color</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<CatalogColorPicker
						client:load
						color={query.color}
						action={colorForm.pathname}
						params={Object.fromEntries(colorForm.params)}
					/>
				</div>
			</details>

			<details class="catalog-acc catalog-acc--exclude" open={Boolean(query.exclude) || undefined} data-filter-section="exclude">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="exclude" />
					</span>
					<span class="catalog-acc__label">Exclude Keywords</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<form class="catalog-exclude" method="get" action={excludeForm.pathname}>
						{
							[...excludeForm.params.entries()].map(([name, value]) => (
								<input type="hidden" name={name} value={value} />
							))
						}
						<label class="visually-hidden" for="catalog-exclude">Keywords to exclude</label>
						<input
							id="catalog-exclude"
							type="search"
							name="exclude"
							value={query.exclude}
							placeholder="e.g. watermark, text"
							maxlength="80"
						/>
						<button type="submit">Apply</button>
					</form>
				</div>
			</details>

			<details class="catalog-acc catalog-acc--sort" open={query.sort !== 'newest' || undefined} data-filter-section="sort">
				<summary>
					<span class="catalog-acc__icon" aria-hidden="true">
						<CatalogFilterIcon name="sort" />
					</span>
					<span class="catalog-acc__label">Sort By</span>
					<span class="catalog-acc__chevron" aria-hidden="true"></span>
				</summary>
				<div class="catalog-acc__panel">
					<ul class="catalog-filter__list">
						{
							CATALOG_SORTS.map((item) => (
								<li>
									<a
										class:list={[query.sort === item.id && 'is-active']}
										href={catalogHref(query, { sort: item.id })}
										aria-current={query.sort === item.id ? 'true' : undefined}
									>
										<span>{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</details>
		</div>
	</aside>

	<div class="catalog-results">
		{
			related.length > 0 && (
				<nav class="catalog-related" data-related aria-label="Related keywords">
					<button
						class="catalog-related__arrow catalog-related__arrow--prev"
						type="button"
						data-related-prev
						hidden
						aria-label="Previous keywords"
					>
						<svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
							<path
								d="M10 3 5 8l5 5"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
					<div class="catalog-related__track" data-related-track>
						{related.map((term) => (
							<a href={catalogHref(query, { q: term })}>{term}</a>
						))}
					</div>
					<button
						class="catalog-related__arrow catalog-related__arrow--next"
						type="button"
						data-related-next
						hidden
						aria-label="More keywords"
					>
						<svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
							<path
								d="M6 3l5 5-5 5"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
				</nav>
			)
		}
		<header class="catalog-results__head">
			<div class="catalog-results__title">
				<h1>{heading}</h1>
			</div>
			<p>
				{intro ? intro.lede : 'Filter by category, type, color, and more.'}
			</p>
			{
				chips.length > 0 && (
					<div class="catalog-chips">
						{chips.map((chip) => (
							<a class="catalog-chips__item" href={chip.href}>
								<em>{chip.kind}</em>
								<strong>{chip.value}</strong>
								<span aria-hidden="true">×</span>
							</a>
						))}
						{hasFilters && (
							<a class="catalog-chips__clear" href={clearHref}>
								Clear all
							</a>
						)}
					</div>
				)
			}
		</header>

		<AssetGrid assets={assets} emptyMessage={emptyMessage} />
	</div>
</div>

<script>
	const STORAGE_KEY = 'istockvisual-catalog-filters';
	const filterQuery = window.matchMedia('(max-width: 860px)');

	function isMobileCatalog() {
		return filterQuery.matches;
	}

	function setMobileFiltersOpen(open) {
		if (open) {
			document.body.classList.remove('nav-open');
			const navToggle = document.querySelector('[data-nav-toggle]');
			if (navToggle) {
				navToggle.setAttribute('aria-expanded', 'false');
				navToggle.setAttribute('aria-label', 'Open menu');
			}
			const navBackdrop = document.querySelector('[data-nav-backdrop]');
			if (navBackdrop) navBackdrop.hidden = true;
		}
		document.body.classList.toggle('catalog-filters-open', open);
		const toggle = document.querySelector('[data-catalog-filter-toggle]');
		if (toggle) {
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Close filters' : 'Open filters');
		}
		document.querySelectorAll('[data-catalog-filter-backdrop]').forEach(function (el) {
			el.hidden = !open;
		});
	}

	function applyCatalogFold(root, collapsed) {
		if (isMobileCatalog()) {
			setMobileFiltersOpen(!collapsed);
			return;
		}
		root.classList.toggle('is-filters-hidden', collapsed);
	}

	document.querySelectorAll('[data-catalog]').forEach(function (root) {
		if (!(root instanceof HTMLElement)) return;
		if (isMobileCatalog()) {
			root.classList.remove('is-filters-hidden');
			setMobileFiltersOpen(false);
		} else {
			try {
				applyCatalogFold(root, localStorage.getItem(STORAGE_KEY) === 'hidden');
			} catch (e) {}
		}

		root.querySelector('[data-catalog-collapse]')?.addEventListener('click', function () {
			applyCatalogFold(root, true);
			try {
				localStorage.setItem(STORAGE_KEY, 'hidden');
			} catch (e) {}
		});

		root.querySelector('[data-catalog-filter-close]')?.addEventListener('click', function () {
			setMobileFiltersOpen(false);
		});

		root.querySelector('[data-catalog-filter-backdrop]')?.addEventListener('click', function () {
			setMobileFiltersOpen(false);
		});

		root.querySelectorAll('[data-catalog-expand]').forEach(function (btn) {
			btn.addEventListener('click', function () {
				applyCatalogFold(root, false);
				const target = btn.getAttribute('data-filter-target');
				if (target) {
					const section = root.querySelector('[data-filter-section="' + CSS.escape(target) + '"]');
					if (section instanceof HTMLDetailsElement) {
						section.open = true;
					}
				}
				try {
					localStorage.setItem(STORAGE_KEY, 'open');
				} catch (e) {}
			});
		});

		const relatedRoot = root.querySelector('[data-related]');
		const track = relatedRoot?.querySelector('[data-related-track]');
		const next = relatedRoot?.querySelector('[data-related-next]');
		const prev = relatedRoot?.querySelector('[data-related-prev]');
		if (
			relatedRoot instanceof HTMLElement &&
			track instanceof HTMLElement &&
			next instanceof HTMLElement &&
			prev instanceof HTMLElement
		) {
			const updateRelated = function () {
				const max = track.scrollWidth - track.clientWidth;
				const overflow = max > 8;
				relatedRoot.classList.toggle('is-overflow', overflow);
				prev.hidden = !overflow || track.scrollLeft <= 8;
				next.hidden = !overflow || track.scrollLeft >= max - 8;
			};
			const jump = function (dir) {
				track.scrollBy({ left: dir * Math.max(240, track.clientWidth * 0.72), behavior: 'smooth' });
			};
			next.addEventListener('click', function () {
				jump(1);
			});
			prev.addEventListener('click', function () {
				jump(-1);
			});
			let relatedDrag = null;
			track.addEventListener('pointerdown', function (event) {
				if (event.pointerType !== 'mouse' || event.button !== 0) return;
				if (event.target instanceof Element && event.target.closest('.catalog-related__arrow')) return;
				relatedDrag = {
					id: event.pointerId,
					x: event.clientX,
					scroll: track.scrollLeft,
					moved: false,
				};
			});
			track.addEventListener('pointermove', function (event) {
				if (!relatedDrag || event.pointerId !== relatedDrag.id) return;
				if (event.buttons !== 1) {
					relatedDrag = null;
					track.classList.remove('is-dragging');
					return;
				}
				const dx = event.clientX - relatedDrag.x;
				if (!relatedDrag.moved) {
					if (Math.abs(dx) < 10) return;
					relatedDrag.moved = true;
					track.classList.add('is-dragging');
					try {
						track.setPointerCapture(event.pointerId);
					} catch (e) {}
				}
				track.scrollLeft = relatedDrag.scroll - dx;
			});
			const endRelatedDrag = function (event) {
				if (!relatedDrag || event.pointerId !== relatedDrag.id) return;
				const moved = relatedDrag.moved;
				relatedDrag = null;
				track.classList.remove('is-dragging');
				if (!moved) return;
				const blockClick = function (clickEvent) {
					clickEvent.preventDefault();
					clickEvent.stopPropagation();
					track.removeEventListener('click', blockClick, true);
				};
				track.addEventListener('click', blockClick, true);
			};
			track.addEventListener('pointerup', endRelatedDrag);
			track.addEventListener('pointercancel', endRelatedDrag);
			track.addEventListener('lostpointercapture', endRelatedDrag);
			track.addEventListener('scroll', updateRelated, { passive: true });
			window.addEventListener('resize', updateRelated);
			updateRelated();
			requestAnimationFrame(updateRelated);
		}
	});

	document.addEventListener('click', function (event) {
		const target = event.target;
		if (!(target instanceof Element)) return;
		if (!target.closest('[data-catalog-filter-toggle]')) return;
		event.preventDefault();
		setMobileFiltersOpen(!document.body.classList.contains('catalog-filters-open'));
	});

	filterQuery.addEventListener('change', function () {
		setMobileFiltersOpen(false);
		document.querySelectorAll('[data-catalog]').forEach(function (root) {
			if (!(root instanceof HTMLElement)) return;
			if (filterQuery.matches) {
				root.classList.remove('is-filters-hidden');
				return;
			}
			try {
				root.classList.toggle('is-filters-hidden', localStorage.getItem(STORAGE_KEY) === 'hidden');
			} catch (e) {}
		});
	});
</script>
