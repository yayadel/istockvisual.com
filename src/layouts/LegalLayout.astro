---
import BaseLayout from './BaseLayout.astro';
import { LEGAL_PAGES, LEGAL_UPDATED } from '../lib/seo';

interface Props {
	title: string;
	description: string;
	heading: string;
	lede: string;
}

const { title, description, heading, lede } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<BaseLayout title={title} description={description}>
	<section class="legal-page">
		<header class="legal-page__head">
			<p class="asset-card__meta">Legal</p>
			<h1>{heading}</h1>
			<p>{lede}</p>
			<nav class="legal-nav" aria-label="Legal pages">
				{
					LEGAL_PAGES.map((item) => (
						<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>
		</header>
		<article class="legal-copy">
			<slot />
		</article>
		<p class="legal-updated">Last updated {LEGAL_UPDATED}</p>
	</section>
</BaseLayout>
