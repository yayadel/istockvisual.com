---
import globalCss from '../styles/global.css?url';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
// import PartnerStrip from '../components/PartnerStrip.astro';
import UploadModal from '../components/UploadModal.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import SupportChat from '../components/SupportChat';
import { stringifyJsonLd, canonicalHref, siteOrigin, SITE_HOME_DESCRIPTION } from '../lib/seo';
import { canonicalizePublicImageUrl, imageMimeFromUrl } from '../lib/public-image';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogType?: string;
	jsonLd?: unknown;
	/** Use `title` as the full document title (no " · StockVisual"). */
	exactTitle?: boolean;
	robots?: string;
	lcpImage?: string;
	/** Lower image preload priority when a heavy client editor loads on the same view. */
	lcpImagePriority?: 'high' | 'auto' | 'low';
	modulePreloads?: string[];
}

const {
	title = 'StockVisual',
	description = SITE_HOME_DESCRIPTION,
	canonicalUrl,
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	ogType = 'website',
	jsonLd,
	exactTitle = false,
	robots = 'index, follow, max-image-preview:large',
	lcpImage,
	lcpImagePriority = 'high',
	modulePreloads = [],
} = Astro.props;

const pagePath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageTitle =
	exactTitle || title === 'StockVisual' ? title : `${title} · StockVisual`;
const canonical = canonicalUrl ?? canonicalHref(Astro.url.pathname, Astro.url.origin);
const jsonLdRaw = jsonLd ? stringifyJsonLd(jsonLd) : '';
const origin = siteOrigin(Astro.url.origin);
const resolvedOgImage = ogImage ? canonicalizePublicImageUrl(ogImage, origin, '1k') : undefined;
const resolvedLcpImage = lcpImage ? canonicalizePublicImageUrl(lcpImage, origin, '1k') : undefined;
const lcpType = imageMimeFromUrl(resolvedLcpImage);
const ogImageType = imageMimeFromUrl(resolvedOgImage);
---

<!doctype html>
<html lang="en" data-page={pagePath === '/c' ? 'categories-hub' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0b0b0b" />
		<link rel="stylesheet" href={globalCss} />
		{
			modulePreloads.map((href) => (
				<link rel="modulepreload" href={href} crossorigin />
			))
		}
		<slot name="head" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Roboto:wght@400;500;700&family=Sora:wght@400;500;600&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Roboto:wght@400;500;700&family=Sora:wght@400;500;600&display=swap"
				rel="stylesheet"
			/>
		</noscript>
		{
			resolvedLcpImage && (
				<link
					rel="preload"
					as="image"
					href={resolvedLcpImage}
					type={lcpType}
					fetchpriority={lcpImagePriority}
				/>
			)
		}
		<title>{pageTitle}</title>
		<meta property="og:site_name" content="StockVisual" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{
			resolvedOgImage && (
				<>
					<meta property="og:image" content={resolvedOgImage} />
					{ogImageType ? <meta property="og:image:type" content={ogImageType} /> : null}
					<meta property="og:image:alt" content={ogImageAlt || pageTitle} />
					{ogImageWidth ? (
						<meta property="og:image:width" content={String(ogImageWidth)} />
					) : null}
					{ogImageHeight ? (
						<meta property="og:image:height" content={String(ogImageHeight)} />
					) : null}
					<meta name="twitter:image" content={resolvedOgImage} />
					<meta name="twitter:image:alt" content={ogImageAlt || pageTitle} />
				</>
			)
		}
		{jsonLdRaw && <script type="application/ld+json" set:html={jsonLdRaw} />}
		<script is:inline>
			(function () {
				try {
					var theme =
						localStorage.getItem('stockvisual-theme') || localStorage.getItem('istockvisual-theme');
					document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
					if (theme && !localStorage.getItem('stockvisual-theme')) {
						localStorage.setItem('stockvisual-theme', theme);
					}
					var privacy =
						localStorage.getItem('stockvisual-privacy-ok') ||
						localStorage.getItem('istockvisual-privacy-ok');
					var stamped = Number(privacy);
					var fresh = privacy && isFinite(stamped) && Date.now() - stamped < 86400000;
					var cookieOk =
						document.cookie.indexOf('stockvisual-privacy-ok=') !== -1 ||
						document.cookie.indexOf('istockvisual-privacy-ok=') !== -1;
					if (cookieOk || fresh) {
						document.documentElement.setAttribute('data-privacy-ok', '1');
						if (fresh && !localStorage.getItem('stockvisual-privacy-ok')) {
							localStorage.setItem('stockvisual-privacy-ok', privacy);
						}
					}
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'light');
				}
			})();
		</script>
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main class="site-main">
				<slot />
			</main>
			{/* <PartnerStrip /> */}
			<SiteFooter />
		</div>
		<UploadModal />
		<PrivacyNotice />
		{Astro.url.pathname.replace(/\/$/, '') !== '/info/help' && <SupportChat client:idle variant="widget" />}
	</body>
</html>
