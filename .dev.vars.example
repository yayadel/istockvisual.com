BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4325
GENERATE_API_SECRET=dev-generate-secret
# Local `npm run dev` serves http://localhost:4325 and reads production D1/R2 (wrangler remote bindings).
# Cloud Agent still hits the production Worker; put the Worker secret in Cursor Secrets as GENERATE_API_SECRET
# GENERATE_BASE_URL=https://istockvisual.com
# GENERATE_API_SECRET_REMOTE=
ADMIN_EMAILS=you@example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=8192
# Search adds billed tokens; leave off unless you need live web facts
# GEMINI_GOOGLE_SEARCH=1
# Optional: proxy or gateway if Google is unreachable
# HTTPS_PROXY=http://127.0.0.1:7890
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Together AI — Help chat uses DeepSeek V4 Flash; Gemma 4 is for npm run agent:meta:gemma
TOGETHER_API_KEY=
TOGETHER_MODEL=google/gemma-4-31B-it
TOGETHER_SUPPORT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Thinking is forced off in scripts/gemma_meta.py (direct JSON, no reasoning)
# TOGETHER_MAX_OUTPUT_TOKENS=8192
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
